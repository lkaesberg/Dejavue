# ---- Database ----
DATABASE_URL=postgres://dejavue:dejavue@localhost:5432/dejavue

# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for fast dev iteration
DISCORD_DEV_GUILD_ID=

# ---- Discord Premium Apps SKU ids (from the developer portal) ----
SKU_PLUS=
SKU_PRO=
SKU_BACKFILL=
SKU_TOPUP=

# ---- AI ----
# Local CPU embedding model (Transformers.js repo id). 384-dim.
EMBEDDING_MODEL=bge-small-en-v1.5
# OpenRouter (OpenAI-compatible) for generative features
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_APP_URL=https://dejavue.app
OPENROUTER_APP_NAME=Dejavue

# ---- Public web KB ----
KB_BASE_DOMAIN=dejavue.app
# Shared secret the worker uses to trigger Astro page revalidation
KB_REVALIDATE_SECRET=
# Public base URL of the web app (for absolute links / sitemaps)
KB_PUBLIC_URL=https://dejavue.app

# ---- Pro generation quota ----
PRO_MONTHLY_QUOTA=300

# ---- Misc ----
NODE_ENV=development
LOG_LEVEL=info
