# ---- Database ----
DATABASE_URL=postgres://dejavue:dejavue@localhost:5432/dejavue

# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for fast dev iteration
DISCORD_DEV_GUILD_ID=
# Optional: Discord webhook for ops alerts (startup, subscriptions, failures).
# Leave blank to disable. Set this on the server only — never commit the URL.
DISCORD_WEBHOOK_URL=

# ---- Discord Premium Apps SKU ids (from the developer portal) ----
SKU_PLUS=
SKU_PRO=
SKU_MAX=
# One-time consumable AI-credit packs — one SKU per pack size (the credit amount
# each grants is fixed in code). Suggested prices (USD, set in the portal):
#   +500 $4.99 · +1,000 $8.99 · +2,000 $15.99 · +5,000 $34.99 (best value).
SKU_TOPUP_500=
SKU_TOPUP_1000=
SKU_TOPUP_2000=
SKU_TOPUP_5000=
# One-time purchase: enable a custom domain for the public KB
SKU_CUSTOM_DOMAIN=

# ---- AI ----
# Embeddings backend: 'local' (self-host CPU, free) or 'openrouter' (API).
EMBEDDING_PROVIDER=local
#   local      → bge-small-en-v1.5 | multilingual-e5-small (Transformers.js, 384-d)
#   openrouter → openai/text-embedding-3-large (uses OPENROUTER_API_KEY)
EMBEDDING_MODEL=bge-small-en-v1.5
# Output dim; MUST match the vector() DB column (384). The OpenRouter backend
# requests this many dims so a big model fits the existing column.
EMBEDDING_DIM=384
# Optional: point the embeddings API elsewhere (e.g. https://api.openai.com/v1
# with EMBEDDING_API_KEY) instead of OpenRouter.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# OpenRouter (OpenAI-compatible) for generative features (+ openrouter embeddings)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_APP_URL=https://dejavue.app
OPENROUTER_APP_NAME=Dejavue

# ---- Public web KB ----
KB_BASE_DOMAIN=dejavue.app
# Shared secret: signs the private-KB gate cookie (and, later, page revalidation).
# REQUIRED in production — the app refuses to boot without it rather than fall back to
# the development constant, which is published in this repository. Generate one with:
#   openssl rand -hex 32
KB_REVALIDATE_SECRET=
# Public base URL of the web app (for absolute links / sitemaps)
KB_PUBLIC_URL=https://dejavue.app

# ---- Monthly AI-credit budgets (1 credit = 1,000 tokens) ----
QUOTA_CREDITS_PLUS=25
QUOTA_CREDITS_PRO=1000
QUOTA_CREDITS_MAX=5000
# MCP endpoint burst limit (requests/minute, Max tier)
MCP_RATE_PER_MIN=30

# ---- Misc ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Product analytics (optional) ----
# Leave unset to disable entirely: no client is created and nothing is sent, which is
# the expected setup when self-hosting.
# Used in two places: the bot/worker send server-scoped operational events (guild id as
# distinct_id, allowlisted properties only), and tenant knowledge-base pages count page
# traffic in the browser in PostHog's cookieless mode (no cookie, no persistent visitor
# id, no person profile). The apex marketing site is never instrumented.
# NOTE: the browser half means this value is rendered into the page. Use a PostHog
# *project* key (phc_...), which is public by design — never a personal key (phx_...).
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# ---- Public knowledge-base ads (Free tier only) ----
# 'none' (default) disables ads entirely — the right setting for a self-hosted instance —
# and falls back to an in-house upgrade promo. 'ethicalads' enables one cookieless,
# non-behavioural ad on Free-tier knowledge bases only, behind an explicit visitor opt-in
# (nothing is requested from the network until the reader agrees). Needs both variables:
# a provider with no publisher id renders a permanently unfilled box, so it stays off.


# ---- Reverse proxies ----
# How many proxies sit in front of this app, each appending to X-Forwarded-For. Decides
# which entry of that header is trustworthy for rate-limit keys — see
# apps/web/src/lib/clientIp.ts. 0 (default) ignores forwarding headers and uses the socket
# peer, which is correct for a directly exposed app. One proxy (Traefik/nginx alone) = 1;
# Cloudflare in front of Traefik = 2. Setting this too HIGH is the dangerous direction:
# it makes the app read an entry the client can write.
TRUSTED_PROXY_HOPS=0

# ---- One-time purchase: backfill a channel's history ----
SKU_BACKFILL=

# ---- Indexing / embedding tuning (all optional, sensible defaults) ----
# Chunks per thread; 0 = unlimited (default: every message stays searchable).
EMBED_MAX_CHUNKS_PER_THREAD=0
# Chunks sent to the embedding backend per request.
EMBED_BATCH_SIZE=64
# Parallel channel history jobs (backfill / reindex). Keep at 1 on a small host.
CHANNEL_JOB_CONCURRENCY=2
# Monthly embedding-token ceilings — a runaway guard, not the product limit.
# Free fails closed; paid tiers alert and keep serving.
QUOTA_EMBED_TOKENS_FREE=500000
QUOTA_EMBED_TOKENS_PLUS=5000000
QUOTA_EMBED_TOKENS_PRO=50000000
QUOTA_EMBED_TOKENS_MAX=200000000
