---
// Public knowledge base — rebuilt from the Claude Design comp. The page is full
// width (no single centered box): the header, hero and footer are full-bleed and
// each set their own inner max-width, while content sits in a 1120/1180 bound. CSS
// custom properties are emitted from the tenant's `/dejavue website` settings
// (see lib/theme.ts), so the whole site re-skins per guild.
import { buildComponentEmbed, type EmbedButton } from '../lib/discordEmbed';
import { jsonForScript } from '../lib/jsonScript';
import { ACCENTS, brandInitial, brandOf, themeVars } from '../lib/theme';
import KbAds from '../components/KbAds.astro';
import KbAnalytics from '../components/KbAnalytics.astro';
// Fonts are self-hosted (bundled from @fontsource) — no requests to Google Fonts,
// which would transmit visitor IPs to Google (GDPR risk, LG München 3 O 17493/20).
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** Social-card image (Open Graph / Twitter). Defaults to the tenant logo when set. */
  ogImage?: string;
  /** og:type — 'website' for listings, 'article' for a single answer page. */
  ogType?: string;
  /** Discord card subtext under the title. Defaults to "<brand> Knowledge Base". */
  embedTagline?: string;
  /** Discord card link buttons. Defaults to a single "Search answers". */
  embedButtons?: EmbedButton[];
}
const { title, description, canonical, noindex, ogType = 'website', embedTagline, embedButtons } = Astro.props;
const cfg = Astro.locals.cfg;
const vars = themeVars(cfg);
const brand = brandOf(cfg, Astro.locals.tenant?.slug ?? undefined);
// Only a real, absolute image URL unfurls; a data: favicon does not, so fall back to
// the tenant's uploaded logo (if any) rather than emitting a useless tag.
const ogImage = Astro.props.ogImage ?? cfg?.kbLogoUrl ?? null;

// Favicon = the KB's logo. With no uploaded logo, fall back to a branded square (accent
// gradient + brand initial) that matches the nav's logo placeholder.
const xmlEscape = (s: string): string =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const ac = ACCENTS[cfg?.kbAccent ?? 'indigo'] ?? ACCENTS.indigo!;
const initial = xmlEscape(brandInitial(brandOf(cfg, Astro.locals.tenant?.slug ?? undefined)));
const faviconSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">' +
  `<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${ac.a}"/><stop offset="1" stop-color="${ac.b}"/></linearGradient></defs>` +
  '<rect width="64" height="64" rx="14" fill="url(#g)"/>' +
  `<text x="32" y="34" font-family="system-ui,Segoe UI,Arial,sans-serif" font-size="34" font-weight="700" fill="#ffffff" text-anchor="middle" dominant-baseline="central">${initial}</text>` +
  '</svg>';
const faviconHref = cfg?.kbLogoUrl ?? `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

// Discord component embed (see lib/discordEmbed.ts), built from the same title,
// description and URL as the OG tags, in the tenant's accent with its logo (if any).
// Only indexable pages get one: noindex pages (search results, 404s, legal) keep the
// plain OG preview, which also keeps a crafted `/search?q=` out of a branded card.
// Private KBs never reach this layout without the unlock cookie (see middleware.ts),
// and Discord's crawler has none, so a gated KB never exposes a card.
const discordEmbed =
  canonical && !noindex
    ? jsonForScript(
        buildComponentEmbed({
          title,
          url: canonical,
          tagline: embedTagline ?? `${brand} Knowledge Base`,
          description,
          thumbnailUrl: ogImage,
          accentColor: ac.a,
          buttons: embedButtons ?? [{ label: 'Search answers', url: `${new URL(canonical).origin}/search` }],
        }),
      )
    : null;

const css = `
  *, *::before, *::after { box-sizing: border-box; }
  /* Reserve the scrollbar gutter so short pages (no scrollbar) don't render
     ~15px wider than long ones — the whole layout used to shift between pages. */
  html { scrollbar-gutter: stable; }
  body.kb-theme { ${vars}; margin:0; width:100%; overflow-x:hidden; min-height:100vh;
    display:flex; flex-direction:column;
    font-family:'Inter', system-ui, sans-serif; color:var(--text); background:var(--bg); }
  body.kb-theme a { color: inherit; text-decoration: none; }
  input { font-family: inherit; }
  ::selection { background: var(--accentsoft); }

  /* Keyboard focus: a visible ring everywhere (overrides the inline outline:none on
     search/filter inputs, which otherwise leaves keyboard users with no focus cue). */
  .kb-theme :focus-visible { outline: 2px solid var(--accentline) !important; outline-offset: 2px; border-radius: 3px; }
  /* Skip link: off-screen until focused, then pinned top-left for keyboard/AT users. */
  .kb-skip { position: absolute; left: -9999px; top: 0; z-index: 100; }
  .kb-skip:focus { left: 12px; top: 12px; background: var(--surface); color: var(--text);
    border: 1px solid var(--border2); border-radius: var(--radsm); padding: 9px 14px; font-size: 14px; font-weight: 600; }
  [id="kb-main"]:focus { outline: none; }

  /* Full-bleed bars with a shared inner bound. */
  .kb-header { position:sticky; top:0; z-index:50; background:var(--bg); border-bottom:1px solid var(--border); }
  /* margin-top:auto makes the footer (the last flex child of the column body) stick to
     the bottom on short pages, and sit flush after content on long ones. */
  .kb-foot { border-top:1px solid var(--border); background:var(--footerbg); margin-top:auto; }
  .kb-bound { max-width:1180px; margin:0 auto; padding-left:clamp(18px,4vw,36px); padding-right:clamp(18px,4vw,36px); }

  /* Home: full-bleed hero + bounded content. Same 1180px bound as the nav,
     footer and inner pages so the content column never changes width between pages. */
  .kb-hero { background:linear-gradient(180deg,var(--hero1),var(--hero2)); border-bottom:1px solid var(--border); padding:clamp(44px,7vw,86px) clamp(18px,4vw,36px); }
  .kb-hero-inner { max-width:740px; margin:0 auto; text-align:center; }
  /* width:100% matters: these are children of the body column-flex, and their
     margin:0 auto disables the default cross-axis stretch — without an explicit
     width they'd shrink to fit-content, so sparse pages rendered narrower than
     full ones (and the rail+main row wrapped when content was short). */
  .kb-home { width:100%; max-width:1180px; margin:0 auto; padding:clamp(30px,4vw,46px) clamp(18px,4vw,36px) clamp(40px,5vw,64px); }
  .cat-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(248px, 1fr)); gap:14px; }

  /* Inner pages: channel-nav rail + main column. The rail is a FIXED 232px on
     every page (it used to flex 196–256px with content pressure, shifting the
     main column from page to page). */
  .kb-inner { width:100%; max-width:1180px; margin:0 auto; padding:0 clamp(18px,4vw,36px); display:flex; flex-wrap:wrap; align-items:flex-start; }
  .kb-rail { flex:0 0 232px; width:232px; padding:28px 22px 28px 0; border-right:1px solid var(--border); }
  .kb-main { flex:999 1 540px; min-width:0; padding:8px 0 24px clamp(0px,3vw,30px); }
  /* Article: content + related rail inside main. */
  .kb-article { display:grid; grid-template-columns:minmax(0,1fr) 232px; gap:0; }

  .kb-link:hover { text-decoration: underline; }
  .kb-row:hover { background: var(--surface2); }
  .kb-card-hover:hover { border-color: var(--accentline) !important; background: var(--surface2); }

  /* Rendered Discord markdown in answers/transcripts (see lib/discordText.ts). */
  .kb-mdlink { color: var(--accentline); text-decoration: underline; word-break: break-word; }
  .kb-code-inline { font-family:'JetBrains Mono', monospace; font-size:0.88em; background:var(--surface2); border:1px solid var(--border); border-radius:5px; padding:1px 5px; }
  .kb-code { font-family:'JetBrains Mono', monospace; font-size:13px; line-height:1.5; background:var(--surface2); border:1px solid var(--border); border-radius:8px; padding:12px 14px; margin:8px 0; overflow-x:auto; white-space:pre; }
  .kb-code code { background:none; border:none; padding:0; }

  /* Mobile channel nav: the rail hides < 980px, so surface the channel list as a
     collapsible menu above the content instead of stranding phone visitors. */
  .kb-mobile-nav { display:none; }
  .kb-mobile-nav > summary { list-style:none; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; margin:14px 0 0; border:1px solid var(--border); border-radius:var(--radsm); background:var(--surface2); font-size:14px; font-weight:600; color:var(--text); }
  .kb-mobile-nav > summary::-webkit-details-marker { display:none; }
  .kb-mobile-nav[open] > summary { border-bottom-left-radius:0; border-bottom-right-radius:0; }
  .kb-mobile-nav .kb-mobile-list { border:1px solid var(--border); border-top:none; border-radius:0 0 var(--radsm) var(--radsm); overflow:hidden; }

  @media (max-width: 980px) { .kb-rail { display:none; } .kb-main { padding-left:0; } .kb-mobile-nav { display:block; flex:0 0 100%; width:100%; } }
  @media (max-width: 860px) { .kb-article { grid-template-columns:1fr; } }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={faviconHref} />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {/* Discord component embed — must be server-rendered; Discord's crawler runs no JS. */}
    {discordEmbed && <script id="discord:component-embed" type="application/json" is:inline set:html={discordEmbed} />}
    <style is:global set:html={css}></style>
    <slot name="head" />
  </head>
  <body class="kb-theme">
    <a href="#kb-main" class="kb-skip">Skip to content</a>
    <slot />
    {/* Free-tier only, and consent-gated — renders nothing for a paying tenant. */}
    <KbAds />
    <KbAnalytics />
  </body>
</html>
