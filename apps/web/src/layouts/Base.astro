---
// Public knowledge base — rebuilt from the Claude Design comp. The page is full
// width (no single centered box): the header, hero and footer are full-bleed and
// each set their own inner max-width, while content sits in a 1120/1180 bound. CSS
// custom properties are emitted from the tenant's `/dejavue customize` settings
// (see lib/theme.ts), so the whole site re-skins per guild.
import { ACCENTS, brandInitial, brandOf, themeVars } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;
const cfg = Astro.locals.cfg;
const vars = themeVars(cfg);

// Favicon = the KB's logo. With no uploaded logo, fall back to a branded square (accent
// gradient + brand initial) that matches the nav's logo placeholder.
const xmlEscape = (s: string): string =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const ac = ACCENTS[cfg?.kbAccent ?? 'indigo'] ?? ACCENTS.indigo!;
const initial = xmlEscape(brandInitial(brandOf(cfg, Astro.locals.tenant?.slug ?? undefined)));
const faviconSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">' +
  `<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${ac.a}"/><stop offset="1" stop-color="${ac.b}"/></linearGradient></defs>` +
  '<rect width="64" height="64" rx="14" fill="url(#g)"/>' +
  `<text x="32" y="34" font-family="system-ui,Segoe UI,Arial,sans-serif" font-size="34" font-weight="700" fill="#ffffff" text-anchor="middle" dominant-baseline="central">${initial}</text>` +
  '</svg>';
const faviconHref = cfg?.kbLogoUrl ?? `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

const css = `
  *, *::before, *::after { box-sizing: border-box; }
  body.kb-theme { ${vars}; margin:0; width:100%; overflow-x:hidden; min-height:100vh;
    display:flex; flex-direction:column;
    font-family:'Inter', system-ui, sans-serif; color:var(--text); background:var(--bg); }
  body.kb-theme a { color: inherit; text-decoration: none; }
  input { font-family: inherit; }
  ::selection { background: rgba(124,58,237,0.22); }

  /* Full-bleed bars with a shared inner bound. */
  .kb-header { position:sticky; top:0; z-index:50; background:var(--bg); border-bottom:1px solid var(--border); }
  /* margin-top:auto makes the footer (the last flex child of the column body) stick to
     the bottom on short pages, and sit flush after content on long ones. */
  .kb-foot { border-top:1px solid var(--border); background:var(--footerbg); margin-top:auto; }
  .kb-bound { max-width:1180px; margin:0 auto; padding-left:clamp(18px,4vw,36px); padding-right:clamp(18px,4vw,36px); }

  /* Home: full-bleed hero + bounded content. */
  .kb-hero { background:linear-gradient(180deg,var(--hero1),var(--hero2)); border-bottom:1px solid var(--border); padding:clamp(44px,7vw,86px) clamp(18px,4vw,36px); }
  .kb-hero-inner { max-width:740px; margin:0 auto; text-align:center; }
  .kb-home { max-width:1120px; margin:0 auto; padding:clamp(30px,4vw,46px) clamp(18px,4vw,36px) clamp(40px,5vw,64px); }
  .cat-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(248px, 1fr)); gap:14px; }

  /* Inner pages: channel-nav rail + main column. */
  .kb-inner { max-width:1180px; margin:0 auto; padding:0 clamp(18px,4vw,36px); display:flex; flex-wrap:wrap; align-items:flex-start; }
  .kb-rail { flex:1 1 220px; max-width:256px; min-width:196px; padding:28px 22px 28px 0; border-right:1px solid var(--border); }
  .kb-main { flex:999 1 540px; min-width:0; padding:8px 0 24px clamp(0px,3vw,30px); }
  /* Article: content + related rail inside main. */
  .kb-article { display:grid; grid-template-columns:minmax(0,1fr) 232px; gap:0; }

  .kb-link:hover { text-decoration: underline; }
  .kb-row:hover { background: var(--surface2); }
  .kb-card-hover:hover { border-color: var(--accentline) !important; background: var(--surface2); }

  @media (max-width: 980px) { .kb-rail { display:none; } .kb-main { padding-left:0; } }
  @media (max-width: 860px) { .kb-article { grid-template-columns:1fr; } }
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href={faviconHref} />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global set:html={css}></style>
    <slot name="head" />
  </head>
  <body class="kb-theme">
    <slot />
  </body>
</html>
