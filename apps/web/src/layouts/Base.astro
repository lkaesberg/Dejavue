---
// Light theme for the public knowledge base (Dejavue brand design).
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      /* Scoped to .kb-theme so the marketing (dark) layout's global body rule,
         which is bundled into the same page, can't leak in and override colors. */
      body.kb-theme { margin: 0; font-family: 'Inter', system-ui, sans-serif; color: #0E0F1C; background: #FFFFFF; }
      body.kb-theme a { color: inherit; text-decoration: none; }
      input { font-family: inherit; }
      /* Centered page — comfortably wide, not edge-to-edge. */
      .kb-page { max-width: 1280px; margin: 0 auto; background: #FFFFFF; min-height: 100vh; color: #0E0F1C; }
      .kb-link:hover { text-decoration: underline; }
      .kb-row:hover { background: #FBFBFE; }
      .kb-card-hover:hover { border-color: #C9C4F2 !important; background: #FBFBFE; }
      /* Responsive horizontal padding shared by every KB section. */
      .kb-pad { padding-left: clamp(16px, 4vw, 44px); padding-right: clamp(16px, 4vw, 44px); }
      /* Category cards: auto-fill so columns adapt from 1 (mobile) to many (wide). */
      .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
      /* Article: main + related sidebar on desktop, stacked on mobile. */
      .kb-twocol { display: grid; grid-template-columns: minmax(0, 1fr) 300px; }
      .kb-main { border-right: 1px solid #EDEDF2; min-width: 0; }
      @media (max-width: 860px) {
        .kb-twocol { grid-template-columns: 1fr; }
        .kb-main { border-right: 0; }
        .kb-aside { border-top: 1px solid #EDEDF2; }
      }
    </style>
  </head>
  <body class="kb-theme">
    <slot />
  </body>
</html>
