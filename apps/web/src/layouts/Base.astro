---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #1a1a2e; --muted: #6b6b80; --accent: #5865f2; --bg: #fff; --card: #f5f6fb;
      }
      @media (prefers-color-scheme: dark) {
        :root { --fg: #e7e7ef; --muted: #9a9aae; --bg: #0f1015; --card: #191a23; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: var(--fg); background: var(--bg); }
      main { max-width: 760px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1 { font-size: 1.9rem; margin: 0 0 .35rem; line-height: 1.2; }
      h2 { font-size: 1.2rem; margin: 2rem 0 .5rem; }
      code { background: var(--card); padding: .1rem .35rem; border-radius: 5px; }
      .muted { color: var(--muted); }
      .card { background: var(--card); border-radius: 12px; padding: 1rem 1.2rem; margin: .6rem 0; }
      .list { list-style: none; padding: 0; margin: 1rem 0; }
      .q { font-weight: 600; margin-bottom: .35rem; }
      .answer { white-space: pre-wrap; }
      .search { display: flex; gap: .5rem; margin: 1.25rem 0 1.75rem; }
      .search input { flex: 1; padding: .65rem .9rem; font-size: 1rem; color: var(--fg); background: var(--card); border: 1px solid transparent; border-radius: 10px; }
      .search input:focus { outline: none; border-color: var(--accent); }
      .search button { padding: .65rem 1.1rem; font-size: 1rem; color: #fff; background: var(--accent); border: 0; border-radius: 10px; cursor: pointer; }
      .dups { list-style: none; padding: 0; margin: .5rem 0 0; }
      .dups li { margin: .25rem 0; font-size: .95rem; }
      footer { margin-top: 3rem; font-size: .85rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
