---
// Dark theme for the marketing site (apex / www).
// Fonts are self-hosted (bundled from @fontsource) — no requests to Google Fonts,
// which would transmit visitor IPs to Google (GDPR risk, LG München 3 O 17493/20).
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const origin = new URL(Astro.request.url).origin;
// OG/Twitter require absolute image URLs. The card (self-hosted, no external
// CDN) is the shared social card for every marketing page — designed like a
// thumbnail: the promise in display type plus the duplicate→solved story, so it
// still reads at Discord/Slack unfurl sizes. Canonical, when set, is the page's
// own URL and doubles as og:url.
const socialImage = `${origin}/media/og-card.png`;
const pageUrl = canonical ?? `${origin}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0B14" />
    {/* Site-name signals for Google (alongside og:site_name + WebSite JSON-LD). */}
    <meta name="application-name" content="Dejavue" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Let Google index the page and show large image previews + full snippets. */}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    {/* Open Graph — Discord / Slack / Facebook / LinkedIn link unfurls. */}
    <meta property="og:site_name" content="Dejavue" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2550" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content="Dejavue: never answer the same question twice" />

    {/* Twitter / X large-image card. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Dejavue: never answer the same question twice" />

    <slot name="head" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      /* Decorative glows deliberately extend past their sections. Clip them on
         the document scroll root as well as the body so mobile browsers cannot
         pan sideways into that off-canvas area. Use `clip`, not `hidden`:
         `overflow-x: hidden` coerces `overflow-y` to `auto`, turning html/body
         into scroll containers and breaking the sticky nav. `overflow-x: clip`
         pairs legally with `overflow-y: visible`, so it clips the horizontal
         overflow without making these elements scroll — keeping position:sticky. */
      html { scrollbar-gutter: stable; overflow-x: clip; }
      /* Scoped to .site-theme so it can't leak into the KB (light) layout, whose
         global body rule is bundled into the same page. */
      body.site-theme { margin: 0; background: #0A0B14; font-family: 'Inter', system-ui, sans-serif; color: #F4F5FF; overflow-x: clip; }
      body.site-theme a { text-decoration: none; }
      ::selection { background: rgba(124,58,237,0.4); color: #fff; }

      /* ---- Responsive marketing grids ---- */
      .site-nav-links { display: flex; align-items: center; gap: 30px; }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 60px; align-items: center; }
      .kb-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
      .assistant-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 44px; align-items: center; }
      .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; }

      @media (max-width: 900px) {
        .hero-grid, .kb-grid { grid-template-columns: 1fr; gap: 40px; }
        .assistant-grid { grid-template-columns: 1fr; gap: 32px; }
        /* The KB demo renders first (left) on desktop; stacked, the copy reads first. */
        .kb-grid > :last-child { order: -1; }
      }
      @media (max-width: 760px) {
        .site-nav-links a:not(.cta) { display: none; }
      }
    </style>
  </head>
  <body class="site-theme">
    <slot />
  </body>
</html>
