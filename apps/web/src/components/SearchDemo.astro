---
const query = 'rotate api key';
---

<div
  class="search-demo"
  data-search-demo
  role="img"
  aria-label="Typing 'rotate api key' into the help-center search instantly surfaces the solved answer 'How do I rotate my API key without downtime?'."
>
  <div class="search-demo__inner" aria-hidden="true">
    <div class="search-demo__tag"><span>04</span> Searched by your users</div>

    <div class="search-demo__card">
      <div class="search-demo__bar">
        <svg viewBox="0 0 18 18"><circle cx="7.4" cy="7.4" r="4.7"></circle><path d="m11.2 11.2 3.4 3.4"></path></svg>
        <span class="search-demo__query">
          <em>Search 42 answers&hellip;</em>
          <span data-sd-query></span><i class="search-demo__caret"></i>
        </span>
        <kbd>⌘K</kbd>
      </div>

      <div class="search-demo__body">
        <div>
          <div class="search-demo__hits">
            <div class="search-demo__hit search-demo__hit--primary">
              <span class="search-demo__hit-icon">
                <svg viewBox="0 0 16 16"><path d="M4.4 1.8h4.8L12 4.6v8.6a1 1 0 0 1-1 1H4.4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1Z"></path><path d="M8.9 1.8v3h3"></path><path d="M5.6 8h4.6M5.6 10.4h3.2"></path></svg>
              </span>
              <div>
                <strong>How do I <mark>rotate</mark> my <mark>API key</mark> without downtime?</strong>
                <small>API · updated today</small>
              </div>
              <span class="search-demo__solved">✓ solved</span>
            </div>
            <div class="search-demo__hit search-demo__hit--dim">
              <span class="search-demo__hit-icon">
                <svg viewBox="0 0 16 16"><path d="M4.4 1.8h4.8L12 4.6v8.6a1 1 0 0 1-1 1H4.4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1Z"></path><path d="M8.9 1.8v3h3"></path><path d="M5.6 8h4.6M5.6 10.4h3.2"></path></svg>
              </span>
              <div>
                <strong>Best practices for storing <mark>API keys</mark></strong>
                <small>Security</small>
              </div>
            </div>
            <div class="search-demo__hit search-demo__hit--dim">
              <span class="search-demo__hit-icon">
                <svg viewBox="0 0 16 16"><path d="M4.4 1.8h4.8L12 4.6v8.6a1 1 0 0 1-1 1H4.4a1 1 0 0 1-1-1V2.8a1 1 0 0 1 1-1Z"></path><path d="M8.9 1.8v3h3"></path><path d="M5.6 8h4.6M5.6 10.4h3.2"></path></svg>
              </span>
              <div>
                <strong><mark>Rotate</mark> webhook signing secrets</strong>
                <small>Webhooks</small>
              </div>
            </div>
          </div>
          <div class="search-demo__foot">
            <span><kbd>↑↓</kbd> navigate</span>
            <span><kbd>↵</kbd> open</span>
            <b>42 answers</b>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const query = 'rotate api key';

  const sleep = (duration: number) => new Promise((resolve) => window.setTimeout(resolve, duration));

  for (const demo of document.querySelectorAll<HTMLElement>('[data-search-demo]')) {
    const output = demo.querySelector<HTMLElement>('[data-sd-query]');
    if (!output) continue;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const showCompletedState = () => {
      demo.dataset.state = 'results';
      demo.classList.add('is-locked');
      output.textContent = query;
    };

    if (reducedMotion.matches) {
      demo.classList.add('is-visible');
      showCompletedState();
      continue;
    }

    const play = async () => {
      while (demo.isConnected) {
        if (reducedMotion.matches) {
          showCompletedState();
          await sleep(1200);
          continue;
        }

        demo.dataset.state = 'idle';
        demo.classList.remove('is-locked');
        output.textContent = '';
        await sleep(80);
        demo.classList.remove('is-resetting');
        await sleep(1350);

        demo.dataset.state = 'typing';
        for (const character of Array.from(query)) {
          if (reducedMotion.matches) break;
          output.textContent += character;
          /* the dropdown unfolds once "rotate " is in the field */
          if (output.textContent.length === 7) demo.dataset.state = 'results';
          await sleep(character === ' ' ? 28 : 56);
        }
        if (reducedMotion.matches) continue;
        await sleep(460);

        demo.classList.add('is-locked');
        await sleep(3400);

        demo.classList.add('is-resetting');
        await sleep(360);
      }
    };

    demo.classList.add('will-animate');
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        demo.classList.add('is-visible');
        observer.disconnect();
        void play();
      },
      { threshold: 0.4 },
    );

    observer.observe(demo);
  }
</script>

<style>
  .search-demo {
    --sd-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    max-width: 405px;
    min-height: 320px;
    margin-top: 40px;
    isolation: isolate;
  }

  .search-demo::before {
    content: '';
    position: absolute;
    inset: -22% -18%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(45, 212, 191, 0.08), transparent 68%);
    pointer-events: none;
  }

  .search-demo__tag {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 11px;
    color: #9aa0c3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .search-demo__tag span {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.32);
    border-radius: 6px;
    background: rgba(167, 139, 250, 0.12);
    color: #c4b5fd;
    font-size: 8.5px;
  }

  .search-demo__card {
    overflow: hidden;
    border: 1px solid rgba(244, 245, 255, 0.14);
    border-radius: 13px;
    background: #fff;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.42);
  }

  .search-demo__bar {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 46px;
    padding: 0 14px;
  }

  .search-demo__bar > svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: #7c3aed;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .search-demo__query {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    color: #1b1d33;
    font-size: 13px;
    white-space: nowrap;
  }

  .search-demo__query em {
    position: absolute;
    left: 0;
    color: #9aa0c3;
    font-style: normal;
    opacity: 0;
    transition: opacity 240ms var(--sd-ease);
  }

  .search-demo[data-state='idle'] .search-demo__query em { opacity: 1; }
  .search-demo.is-resetting .search-demo__query em { opacity: 0; }

  .search-demo__caret {
    display: inline-block;
    flex-shrink: 0;
    width: 1.5px;
    height: 1.2em;
    margin-left: 2px;
    background: #7c3aed;
    animation: sd-blink 760ms steps(1, end) infinite;
  }

  .search-demo__bar > kbd,
  .search-demo__foot kbd {
    flex-shrink: 0;
    padding: 3px 6px;
    border: 1px solid #e3e4ec;
    border-bottom-width: 2px;
    border-radius: 5px;
    background: #f7f7fb;
    color: #8b91a4;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
    font-weight: 600;
  }

  /* ---- the dropdown unfolds beneath the bar --------------------------- */

  .search-demo__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 480ms var(--sd-ease);
  }

  .search-demo__body > div { min-height: 0; overflow: hidden; }

  .search-demo[data-state='results'] .search-demo__body { grid-template-rows: 1fr; }

  .search-demo__hits { padding: 3px 8px 8px; border-top: 1px solid #edeef4; }

  .search-demo__hit {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 11px;
    align-items: center;
    margin-top: 5px;
    padding: 9px 10px;
    border-left: 3px solid transparent;
    border-radius: 9px;
    opacity: 0;
    transform: translateY(7px);
    transition:
      opacity 380ms var(--sd-ease),
      transform 440ms var(--sd-ease),
      background 260ms var(--sd-ease),
      border-color 260ms var(--sd-ease);
  }

  /* flat left edge so the accent bar runs straight instead of hugging the corner radius */
  .search-demo__hit--primary { border-radius: 0 9px 9px 0; }

  .search-demo[data-state='results'] .search-demo__hit { opacity: 1; transform: none; }
  .search-demo[data-state='results'] .search-demo__hit:nth-child(1) { transition-delay: 40ms; }
  .search-demo[data-state='results'] .search-demo__hit:nth-child(2) { transition-delay: 120ms; }
  .search-demo[data-state='results'] .search-demo__hit:nth-child(3) { transition-delay: 200ms; }

  .search-demo__hit-icon {
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border-radius: 7px;
    background: #f1f0fb;
    color: #6d5fe8;
  }

  .search-demo__hit-icon svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.25;
  }

  .search-demo__hit strong {
    display: block;
    overflow: hidden;
    color: #1b1d33;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-demo__hit strong mark {
    padding: 0 2px;
    border-radius: 3px;
    background: rgba(124, 58, 237, 0.12);
    color: #5b3fd4;
  }

  .search-demo__hit small { display: block; margin-top: 2px; color: #9aa0c3; font-size: 9.5px; }

  .search-demo__solved {
    padding: 4px 8px;
    border-radius: 999px;
    background: #e6faf5;
    color: #0f9b82;
    font-size: 9px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* the top hit lights up once the query is complete */
  .search-demo.is-locked .search-demo__hit--primary {
    background: #f6f4ff;
    box-shadow: inset 3px 0 0 #7c3aed;
  }

  .search-demo.is-locked .search-demo__hit--dim { opacity: 0.45; }

  .search-demo__foot {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 14px;
    border-top: 1px solid #edeef4;
    color: #9aa0c3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
  }

  .search-demo__foot span { display: inline-flex; align-items: center; gap: 5px; }
  .search-demo__foot kbd { padding: 2px 4px; font-size: 7.5px; }
  .search-demo__foot b { margin-left: auto; color: #8b91a4; font-weight: 600; }

  /* ---- loop reset ------------------------------------------------------ */

  .search-demo.is-resetting .search-demo__body > div,
  .search-demo.is-resetting .search-demo__query span {
    opacity: 0;
    transition: opacity 300ms var(--sd-ease);
  }

  /* ---- entrance -------------------------------------------------------- */

  .search-demo.will-animate .search-demo__inner { opacity: 0; transform: translateY(16px); }
  .search-demo__inner { transition: opacity 700ms var(--sd-ease), transform 700ms var(--sd-ease); }
  .search-demo.is-visible .search-demo__inner { opacity: 1; transform: none; }

  @keyframes sd-blink {
    0%, 48% { opacity: 1; }
    49%, 100% { opacity: 0; }
  }

  /* the card exists to balance the desktop grid; stacked layouts don't need it */
  @media (max-width: 900px) {
    .search-demo { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-demo *,
    .search-demo *::before,
    .search-demo *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
