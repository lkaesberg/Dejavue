---
import { channelPath } from '../lib/slug';
import { channelDot } from '../lib/theme';

interface Channel {
  id: string;
  name: string;
  count: number;
}
interface Topic {
  name: string;
  count: number;
  q: string;
}
interface Props {
  channels: Channel[];
  activeChannelId?: string | null;
  topics?: Topic[];
  isPaid?: boolean;
}
const { channels, activeChannelId = null, topics = [], isPaid = false } = Astro.props;
---

<details class="kb-mobile-nav">
  <summary>
    <span>Browse channels</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
  </summary>
  <div class="kb-mobile-list">
    {
      channels.map((c) => {
        const active = c.id === activeChannelId;
        return (
          <a
            href={channelPath(c)}
            class="kb-row"
            style={`display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; color:${active ? 'var(--accentline)' : 'var(--textmid)'}; background:${active ? 'var(--accentsoft)' : 'transparent'};`}
          >
            <span style="display:flex; align-items:center; gap:9px; min-width:0;">
              <span style={`width:8px; height:8px; border-radius:50%; flex-shrink:0; background:${channelDot(c.id)};`} />
              <span style="font-size:14px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{c.name}</span>
            </span>
            <span style="font-family:'JetBrains Mono',monospace; font-size:11px; padding:2px 8px; border-radius:999px; flex-shrink:0; color:var(--chiptext); background:var(--chipbg);">{c.count}</span>
          </a>
        );
      })
    }
  </div>
</details>

<aside class="kb-rail">
  <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600; padding:0 10px 10px;">Browse channels</div>
  <div style="display:flex; flex-direction:column; gap:2px;">
    {
      channels.map((c) => {
        const active = c.id === activeChannelId;
        return (
          <a
            href={channelPath(c)}
            class="kb-row"
            style={`display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 11px; border-radius:var(--radsm); color:${active ? 'var(--accentline)' : 'var(--textmid)'}; background:${active ? 'var(--accentsoft)' : 'transparent'};`}
          >
            <span style="display:flex; align-items:center; gap:9px; min-width:0;">
              <span style={`width:8px; height:8px; border-radius:50%; flex-shrink:0; background:${channelDot(c.id)};`} />
              <span style="font-size:13.5px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{c.name}</span>
            </span>
            <span style="font-family:'JetBrains Mono',monospace; font-size:11px; padding:2px 8px; border-radius:999px; flex-shrink:0; color:var(--chiptext); background:var(--chipbg);">{c.count}</span>
          </a>
        );
      })
    }
  </div>

  <div style="height:1px; background:var(--border); margin:18px 10px;"></div>
  <div style="display:flex; align-items:center; justify-content:space-between; padding:0 10px 10px;">
    <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Browse by topic</span>
    {!isPaid && (
      <span style="font-size:9px; font-weight:700; color:#fff; background:linear-gradient(135deg,var(--accent),var(--accent2)); padding:2px 7px; border-radius:999px;">PRO</span>
    )}
  </div>
  {
    isPaid && topics.length > 0 ? (
      <div style="display:flex; flex-direction:column; gap:2px;">
        {topics.map((t) => (
          <a href={`/search?q=${encodeURIComponent(t.q)}`} class="kb-row" style="display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 11px; border-radius:var(--radsm); color:var(--textmid);">
            <span style="font-size:13.5px; font-weight:500;">{t.name}</span>
            <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--textmut);">{t.count}</span>
          </a>
        ))}
      </div>
    ) : !isPaid ? (
      <div style="margin:0 10px; padding:14px; border:1px dashed var(--border2); border-radius:var(--radsm); background:var(--surface2);">
        <div style="font-size:12.5px; line-height:1.5; color:var(--textmut);">
          AI clusters recurring questions into themes. <span style="color:var(--accentline); font-weight:500;">Upgrade to Pro</span> to browse by topic.
        </div>
      </div>
    ) : null
  }
</aside>
