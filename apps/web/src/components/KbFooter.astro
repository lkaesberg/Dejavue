---
import { brandOf } from '../lib/theme';
import Echo from './Echo.astro';

interface Props {
  note?: string;
}
const { note = '' } = Astro.props;
const { cfg, tenant, branded } = Astro.locals;
const brand = brandOf(cfg, tenant?.slug ?? undefined);
---

<footer class="kb-foot">
  <div class="kb-bound" style="padding-top:20px; padding-bottom:20px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    {
      branded ? (
        <div style="display:flex; align-items:center; gap:7px;">
          <Echo tile="none" bubbleFill="#4F46E5" checkFill="#2DD4BF" showEcho={false} size={22} />
          <span style="font-size:13px; color:var(--textmut);">Knowledge base by</span>
          <span style="font-family:var(--headfont); font-weight:700; font-size:16px; letter-spacing:-0.02em; color:var(--textmid);">dejavue</span>
        </div>
      ) : (
        <span style="font-family:var(--headfont); font-weight:700; font-size:16px; letter-spacing:-0.02em; color:var(--textmid);">{brand} Help Center</span>
      )
    }
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
      <a href="/imprint" class="kb-link" style="font-size:13px; color:var(--textmid);">Imprint</a>
      <a href="/privacy" class="kb-link" style="font-size:13px; color:var(--textmid);">Privacy Policy</a>
      {
        note && (
          <>
            <span style="width:3px; height:3px; border-radius:50%; background:var(--border2);"></span>
            <span style="font-size:12.5px; color:var(--textmut);">{note}</span>
          </>
        )
      }
    </div>
  </div>
</footer>
