---
import Echo from './Echo.astro';

// The same canonical question that runs through HeroDemo and PublicSiteDemo —
// here a member asks their AI assistant, which searches the community's
// published answers over MCP and cites the solved thread.
const question = 'How do I rotate a Helio API key without downtime?';
const answer =
  'Create a second key in Settings → API and deploy it alongside the old one. Both keys stay valid while traffic moves over, so nothing drops. Revoke the original once it stops receiving requests.';
const results = [
  { title: 'Rotating API keys with zero downtime', match: '96%' },
  { title: 'Do webhooks pause during key rotation?', match: '84%' },
  { title: 'Grace period for revoked keys', match: '79%' },
];
---

<div
  class="ai-demo"
  data-ai-demo
  data-phase="done"
  role="img"
  aria-label="AI assistant demo: a member asks how to rotate a Helio API key, the assistant searches Helio's published community answers on Dejavue, finds three solved threads, and replies with the community's fix, citing the source."
>
  <div class="ai-demo__glow" aria-hidden="true"></div>
  <div class="ai-demo__echo ai-demo__echo--one" aria-hidden="true"></div>
  <div class="ai-demo__echo ai-demo__echo--two" aria-hidden="true"></div>

  <div class="ai-demo__window" aria-hidden="true">
    <div class="ai-demo__camera">
    <header class="ai-demo__titlebar">
      <span class="ai-demo__model">
        <i>✦</i>
        <strong data-model-name>Claude Fable 5</strong>
        <svg viewBox="0 0 16 16"><path d="m4.5 6.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <span class="ai-demo__connection"><i></i>Helio<em> knowledge base</em></span>
    </header>

    <div class="ai-demo__thread">
      <div class="ai-demo__empty">
        <span>✦</span>
        <strong>Ask about Helio</strong>
        <small>Answers come from the community&rsquo;s solved threads.</small>
      </div>

      <div class="ai-demo__user">{question}</div>

      <div class="ai-demo__turn">
        <span class="ai-demo__assistant-avatar">✦</span>
        <div class="ai-demo__turn-body">
          <div class="ai-demo__slot">
            <span class="ai-demo__thinking"><i></i><i></i><i></i></span>

            <div class="ai-demo__tool">
              <div class="ai-demo__tool-head">
                <Echo tile="gradient" round={true} size={20} style="flex-shrink:0;" />
                <strong>Searching Helio&rsquo;s answers</strong>
                <span class="ai-demo__tool-state">
                  <i></i><b>✓</b><span data-tool-status>3 answers · 0.4s</span>
                </span>
              </div>
              <div class="ai-demo__tool-call">
                <span class="ai-demo__fn">search_knowledge_base</span><span class="ai-demo__paren">(</span><span class="ai-demo__arg">"rotate API key without downtime"</span><span class="ai-demo__paren">)</span>
              </div>
              <div class="ai-demo__endpoint">via helio.dejavue.app/mcp</div>
              <div class="ai-demo__results">
                <div class="ai-demo__scanline"></div>
                {results.map((r, i) => (
                  <div class="ai-demo__row" style={`--row-delay:${i * 90}ms`}>
                    <span class="ai-demo__row-skeleton"><span></span><i></i></span>
                    <span class="ai-demo__row-real"><b>✓</b><span>{r.title}</span><small>{r.match}</small></span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <p class="ai-demo__answer"><span data-answer-output>{answer}</span><span class="ai-demo__caret ai-demo__caret--answer"></span></p>

          <div class="ai-demo__source">
            <b>✓</b>
            <span>Rotating API keys with zero downtime</span>
            <small>helio.dejavue.app</small>
          </div>
        </div>
      </div>
    </div>

    <div class="ai-demo__composer">
      <div class="ai-demo__input">
        <span class="ai-demo__placeholder">Ask about Helio…</span>
        <span class="ai-demo__typed" data-composer-text></span><span class="ai-demo__caret ai-demo__caret--composer"></span>
      </div>
      <span class="ai-demo__send" data-send>
        <svg viewBox="0 0 16 16"><path d="M8 12.5v-9M4.5 7 8 3.5 11.5 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <span class="ai-demo__cursor">
        <svg viewBox="0 0 20 20"><path d="M4.5 2.2v14.1l3.4-3.1 2.1 4.9 2.6-1.1-2.1-4.8 4.6-.5z" fill="#f4f5ff" stroke="#11121f" stroke-width="1.3" stroke-linejoin="round"></path></svg>
      </span>
    </div>
    </div>
  </div>
</div>

<script>
  const question = 'How do I rotate a Helio API key without downtime?';
  const answer =
    'Create a second key in Settings → API and deploy it alongside the old one. Both keys stay valid while traffic moves over, so nothing drops. Revoke the original once it stops receiving requests.';
  // One rotation drives both the section headline ("Ask <model>.") and the
  // window's model chip, so the two never contradict each other.
  const modelCycle = [
    { headline: 'Fable 5', chip: 'Claude Fable 5' },
    { headline: 'GPT-5.6 Sol', chip: 'GPT-5.6 Sol' },
    { headline: 'Grok 4.5', chip: 'Grok 4.5' },
  ];

  const sleep = (duration: number) => new Promise((resolve) => window.setTimeout(resolve, duration));

  for (const demo of document.querySelectorAll<HTMLElement>('[data-ai-demo]')) {
    const composerText = demo.querySelector<HTMLElement>('[data-composer-text]');
    const answerOutput = demo.querySelector<HTMLElement>('[data-answer-output]');
    const toolStatus = demo.querySelector<HTMLElement>('[data-tool-status]');
    const modelName = demo.querySelector<HTMLElement>('[data-model-name]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!composerText || !answerOutput || !toolStatus || !modelName) continue;

    let visible = false;
    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
      },
      { threshold: 0.3 },
    );
    observer.observe(demo);

    const showCompletedState = () => {
      demo.dataset.phase = 'done';
      demo.classList.remove('is-inputting', 'is-sending', 'is-streaming', 'is-resetting', 'is-cursor-in', 'is-cursor-send');
      delete demo.dataset.camera;
      composerText.textContent = '';
      answerOutput.textContent = answer;
      toolStatus.textContent = '3 answers · 0.4s';
    };

    const typeCharacters = async (target: HTMLElement, text: string) => {
      target.textContent = '';
      for (const character of Array.from(text)) {
        if (reducedMotion.matches) return false;
        target.textContent += character;
        const pause = character === '?' ? 140 : character === ' ' ? 20 : 32;
        await sleep(pause);
      }
      return true;
    };

    const streamWords = async (target: HTMLElement, text: string) => {
      target.textContent = '';
      for (const token of text.split(/(\s+)/)) {
        if (reducedMotion.matches) return false;
        target.textContent += token;
        if (token.trim()) await sleep(/[,.]$/.test(token) ? 80 : 42);
      }
      return true;
    };

    const play = async () => {
      while (demo.isConnected) {
        if (reducedMotion.matches) {
          showCompletedState();
          await sleep(1200);
          continue;
        }
        if (!visible) {
          await sleep(400);
          continue;
        }

        demo.dataset.phase = 'compose';
        // Camera dollies into the composer so the typing carries the frame,
        // instead of playing out in a sliver under an empty thread.
        demo.dataset.camera = 'focus';
        demo.classList.remove('is-streaming');
        composerText.textContent = '';
        answerOutput.textContent = '';
        toolStatus.textContent = 'Searching…';
        await sleep(820);

        demo.classList.add('is-inputting');
        if (!(await typeCharacters(composerText, question))) continue;
        await sleep(420);

        demo.classList.add('is-cursor-in');
        await sleep(340);
        demo.classList.add('is-cursor-send');
        await sleep(560);

        demo.classList.add('is-sending');
        await sleep(340);

        // Hold the focused framing through the click, then reveal the full
        // conversation before any assistant state appears.
        demo.classList.remove('is-sending', 'is-cursor-in', 'is-cursor-send');
        delete demo.dataset.camera;
        await sleep(820);

        demo.classList.remove('is-inputting');
        demo.dataset.phase = 'sent';
        composerText.textContent = '';
        await sleep(980);
        if (reducedMotion.matches) continue;

        demo.dataset.phase = 'tool';
        await sleep(1550);

        demo.dataset.phase = 'results';
        toolStatus.textContent = '3 answers · 0.4s';
        await sleep(880);

        demo.dataset.phase = 'answer';
        demo.classList.add('is-streaming');
        if (!(await streamWords(answerOutput, answer))) continue;
        demo.classList.remove('is-streaming');
        await sleep(320);

        demo.dataset.phase = 'done';
        await sleep(4800);

        demo.classList.add('is-resetting');
        await sleep(360);
        demo.dataset.phase = 'compose';
        await sleep(80);
        demo.classList.remove('is-resetting');
      }
    };

    // Types/deletes the model name in the section headline and keeps the
    // window's model chip in step. The headline lives in the page (index.astro)
    // and is optional — without it, the chip stays on the default model.
    const rotatorWrap = document.querySelector<HTMLElement>('[data-model-rotator]');
    const headlineName = rotatorWrap?.querySelector<HTMLElement>('[data-model-headline]') ?? null;

    const rotateModels = async () => {
      if (!rotatorWrap || !headlineName) return;
      let index = 0;
      while (demo.isConnected) {
        if (reducedMotion.matches || !visible) {
          await sleep(700);
          continue;
        }
        await sleep(2700);
        if (reducedMotion.matches) continue;

        index = (index + 1) % modelCycle.length;
        const next = modelCycle[index] ?? modelCycle[0];
        rotatorWrap.classList.add('is-morphing');
        const current = headlineName.textContent ?? '';
        for (let i = current.length - 1; i >= 0; i--) {
          headlineName.textContent = current.slice(0, i);
          await sleep(34);
        }
        await sleep(210);
        modelName.textContent = next.chip;
        for (const character of Array.from(next.headline)) {
          headlineName.textContent += character;
          await sleep(58);
        }
        await sleep(350);
        rotatorWrap.classList.remove('is-morphing');
      }
    };

    void play();
    void rotateModels();
  }
</script>

<style>
  .ai-demo {
    --ai-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --ai-camera-scale: 1.5;
    --ai-camera-shift: 25%;
    --ai-send-focus-shift: -188px;
    --ai-send-shift: 0px;
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    isolation: isolate;
  }

  .ai-demo[data-camera='focus'] {
    --ai-send-shift: var(--ai-send-focus-shift);
  }

  .ai-demo__glow {
    position: absolute;
    inset: -12% -10%;
    z-index: -3;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.18), rgba(79, 70, 229, 0.05) 48%, transparent 72%);
    pointer-events: none;
  }

  .ai-demo__echo {
    position: absolute;
    z-index: -2;
    width: 72%;
    height: 68%;
    border: 1px solid rgba(167, 139, 250, 0.14);
    border-radius: 24px;
    pointer-events: none;
  }

  .ai-demo__echo--one { inset: -12px 22px auto auto; opacity: 0.6; }
  .ai-demo__echo--two { inset: -24px 42px auto auto; opacity: 0.28; }

  .ai-demo__window {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(244, 245, 255, 0.11);
    border-radius: 20px;
    background: #11121f;
    box-shadow: 0 34px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(124, 58, 237, 0.05);
    contain: layout paint;
  }

  /* Camera rig: one fixed framing holds for the complete typing and send beat.
     The bottom-left composition keeps the full question in view without ever
     tracking the caret horizontally. */
  .ai-demo__camera {
    display: flex;
    flex-direction: column;
    transform-origin: 50% 100%;
    transition: transform 780ms var(--ai-ease);
  }

  .ai-demo[data-camera='focus'] .ai-demo__camera {
    transform: translateX(var(--ai-camera-shift)) scale(var(--ai-camera-scale));
  }

  .ai-demo__titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 50px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(244, 245, 255, 0.07);
    background: #161727;
  }

  .ai-demo__model {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    padding: 6px 11px;
    border: 1px solid rgba(244, 245, 255, 0.1);
    border-radius: 999px;
    background: rgba(244, 245, 255, 0.05);
    transition: opacity 220ms ease;
  }

  .ai-demo__model i { color: #a78bfa; font-size: 11px; font-style: normal; }

  .ai-demo__model strong {
    overflow: hidden;
    color: #f4f5ff;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-demo__model svg { width: 11px; height: 11px; flex: 0 0 auto; color: #8d93b5; }

  .ai-demo__connection {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 7px;
    color: #b9bdd3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    white-space: nowrap;
  }

  .ai-demo__connection em { font-style: normal; }
  .ai-demo__connection i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.11);
  }

  .ai-demo__thread {
    position: relative;
    display: flex;
    min-height: 384px;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    background: radial-gradient(circle at 50% 0%, rgba(79, 70, 229, 0.09), transparent 55%), #0c0d17;
    opacity: 1;
    transform: scale(1);
    transition: opacity 280ms ease, transform 360ms var(--ai-ease);
  }

  .ai-demo.is-resetting .ai-demo__thread {
    opacity: 0;
    transform: scale(0.985);
  }

  .ai-demo__empty {
    position: absolute;
    inset: 0 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .ai-demo[data-phase='compose'] .ai-demo__empty { opacity: 1; }

  .ai-demo__empty span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 50%;
    background: rgba(167, 139, 250, 0.08);
    color: #a78bfa;
    font-size: 13px;
  }

  .ai-demo__empty strong {
    margin-top: 3px;
    color: #b9bdd3;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ai-demo__empty small {
    color: #6f7596;
    font-size: 10.5px;
  }

  .ai-demo__user {
    align-self: flex-end;
    max-width: 78%;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.22);
    color: #f4f5ff;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(10px) scale(0.97);
    transition: opacity 300ms var(--ai-ease), transform 380ms var(--ai-ease);
  }

  .ai-demo:not([data-phase='compose']) .ai-demo__user {
    opacity: 1;
    transform: none;
  }

  .ai-demo__turn {
    display: flex;
    gap: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 300ms var(--ai-ease) 120ms, transform 380ms var(--ai-ease) 120ms;
  }

  .ai-demo:not([data-phase='compose']) .ai-demo__turn {
    opacity: 1;
    transform: none;
  }

  .ai-demo__assistant-avatar {
    display: grid;
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(167, 139, 250, 0.24);
    border-radius: 50%;
    background: rgba(167, 139, 250, 0.12);
    color: #c4b5fd;
    font-size: 11px;
  }

  .ai-demo__turn-body {
    min-width: 0;
    flex: 1;
  }

  .ai-demo__slot { display: grid; }
  .ai-demo__slot > * { grid-area: 1 / 1; }

  .ai-demo__thinking {
    display: inline-flex;
    gap: 4px;
    align-self: start;
    padding-top: 8px;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .ai-demo[data-phase='sent'] .ai-demo__thinking { opacity: 1; }

  .ai-demo__thinking i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #a78bfa;
    animation: ai-demo-thinking 900ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .ai-demo__thinking i:nth-child(2) { animation-delay: 120ms; }
  .ai-demo__thinking i:nth-child(3) { animation-delay: 240ms; }

  .ai-demo__tool {
    overflow: hidden;
    border: 1px solid rgba(167, 139, 250, 0.22);
    border-radius: 12px;
    background: #0b0c15;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 320ms var(--ai-ease), transform 400ms var(--ai-ease);
  }

  .ai-demo:is([data-phase='tool'], [data-phase='results'], [data-phase='answer'], [data-phase='done']) .ai-demo__tool {
    opacity: 1;
    transform: none;
  }

  .ai-demo__tool-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border-bottom: 1px solid rgba(244, 245, 255, 0.06);
    background: #10111c;
  }

  .ai-demo__tool-head strong {
    overflow: hidden;
    flex: 1;
    min-width: 0;
    color: #f4f5ff;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-demo__tool-state {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 6px;
    color: #8d93b5;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
    white-space: nowrap;
  }

  .ai-demo__tool-state i {
    width: 10px;
    height: 10px;
    border: 1.5px solid rgba(167, 139, 250, 0.28);
    border-top-color: #a78bfa;
    border-radius: 50%;
    animation: ai-demo-spin 700ms linear infinite;
  }

  .ai-demo__tool-state b { display: none; color: #2dd4bf; font-size: 10px; }

  .ai-demo:is([data-phase='results'], [data-phase='answer'], [data-phase='done']) .ai-demo__tool-state i { display: none; }
  .ai-demo:is([data-phase='results'], [data-phase='answer'], [data-phase='done']) .ai-demo__tool-state b { display: inline; }

  .ai-demo__tool-call {
    padding: 9px 12px 0;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-demo__fn { color: #2dd4bf; }
  .ai-demo__paren { color: #6f7596; }
  .ai-demo__arg { color: #b9bdd3; }

  .ai-demo__endpoint {
    padding: 3px 12px 0;
    color: #6f7596;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
  }

  .ai-demo__results {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 11px 11px;
    overflow: hidden;
  }

  .ai-demo__scanline {
    position: absolute;
    inset: -18px 0 auto;
    z-index: 1;
    display: none;
    height: 38px;
    background: linear-gradient(180deg, transparent, rgba(167, 139, 250, 0.08), transparent);
    pointer-events: none;
  }

  .ai-demo[data-phase='tool'] .ai-demo__scanline {
    display: block;
    animation: ai-demo-scan 1450ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .ai-demo__row {
    display: grid;
    align-items: center;
    min-height: 30px;
    padding: 0 10px;
    border-radius: 8px;
    background: #10111c;
  }

  .ai-demo__row > * { grid-area: 1 / 1; }

  .ai-demo__row-skeleton {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 1;
    transition: opacity 240ms ease;
  }

  .ai-demo__row-skeleton span,
  .ai-demo__row-skeleton i {
    display: block;
    height: 5px;
    border-radius: 999px;
    background: #23253a;
  }

  .ai-demo__row-skeleton span { width: 58%; }
  .ai-demo__row-skeleton i { width: 12%; margin-left: auto; }
  .ai-demo__row:nth-child(3) .ai-demo__row-skeleton span { width: 66%; }
  .ai-demo__row:nth-child(4) .ai-demo__row-skeleton span { width: 48%; }

  .ai-demo__row-real {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 280ms var(--ai-ease), transform 340ms var(--ai-ease);
  }

  .ai-demo__row-real b { color: #2dd4bf; font-size: 10px; }

  .ai-demo__row-real > span {
    overflow: hidden;
    flex: 1;
    min-width: 0;
    color: #dbdee1;
    font-size: 10.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-demo__row-real small {
    color: #c4b5fd;
    font-family: 'JetBrains Mono', monospace;
    font-size: 8.5px;
  }

  .ai-demo:is([data-phase='results'], [data-phase='answer'], [data-phase='done']) .ai-demo__row-skeleton { opacity: 0; }

  .ai-demo:is([data-phase='results'], [data-phase='answer'], [data-phase='done']) .ai-demo__row-real {
    opacity: 1;
    transform: none;
    transition-delay: var(--row-delay);
  }

  .ai-demo__answer {
    min-height: 74px;
    margin: 12px 0 0;
    color: #dbdee1;
    font-size: 12px;
    line-height: 1.55;
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .ai-demo:is([data-phase='answer'], [data-phase='done']) .ai-demo__answer { opacity: 1; }

