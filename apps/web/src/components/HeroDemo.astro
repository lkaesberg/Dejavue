<script>
  const question = 'How do I rotate an API key without downtime?';
  const answer =
    'Create a second key in Settings → API, deploy it alongside the old one, then revoke the first after traffic has migrated. Both keys stay valid during the overlap, so there is no downtime.';

  const sleep = (duration: number) => new Promise((resolve) => window.setTimeout(resolve, duration));

  for (const demo of document.querySelectorAll<HTMLElement>('[data-hero-demo]')) {
    const questionOutput = demo.querySelector<HTMLElement>('[data-question-output]');
    const answerOutput = demo.querySelector<HTMLElement>('[data-answer-output]');
    const postLabel = demo.querySelector<HTMLElement>('[data-post-label]');
    const stateLabel = demo.querySelector<HTMLElement>('[data-state-label]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!questionOutput || !answerOutput || !postLabel || !stateLabel) continue;

    const showCompletedState = () => {
      demo.dataset.phase = 'answer';
      demo.classList.remove('is-inputting', 'is-sending', 'is-streaming', 'is-resetting');
      demo.classList.add('is-complete');
      questionOutput.textContent = question;
      answerOutput.textContent = answer;
      postLabel.textContent = 'Post question';
      stateLabel.textContent = 'Answered & solved';
    };

    const typeCharacters = async (target: HTMLElement, text: string) => {
      target.textContent = '';
      for (const character of Array.from(text)) {
        if (reducedMotion.matches) return false;
        target.textContent += character;
        const pause = character === '?' ? 150 : character === ' ' ? 22 : 38;
        await sleep(pause);
      }
      return true;
    };

    const streamWords = async (target: HTMLElement, text: string) => {
      target.textContent = '';
      for (const token of text.split(/(\s+)/)) {
        if (reducedMotion.matches) return false;
        target.textContent += token;
        if (token.trim()) await sleep(/[,.]$/.test(token) ? 82 : 42);
      }
      return true;
    };

    const play = async () => {
      while (demo.isConnected) {
        if (reducedMotion.matches) {
          showCompletedState();
          await sleep(1000);
          continue;
        }

        demo.dataset.phase = 'compose';
        demo.classList.remove('is-complete', 'is-sending', 'is-streaming');
        questionOutput.textContent = '';
        answerOutput.textContent = '';
        postLabel.textContent = 'Post question';
        stateLabel.textContent = 'New post';
        await sleep(700);

        demo.classList.add('is-inputting');
        if (!(await typeCharacters(questionOutput, question))) continue;
        demo.classList.remove('is-inputting');
        await sleep(360);

        demo.classList.add('is-sending');
        postLabel.textContent = 'Posting…';
        stateLabel.textContent = 'Publishing question';
        await sleep(520);

        demo.classList.remove('is-sending');
        demo.dataset.phase = 'search';
        stateLabel.textContent = 'Searching the archive';
        await sleep(1750);
        if (reducedMotion.matches) continue;

        demo.dataset.phase = 'answer';
        stateLabel.textContent = 'Found 3 matches';
        await sleep(480);

        demo.classList.add('is-streaming');
        if (!(await streamWords(answerOutput, answer))) continue;
        demo.classList.remove('is-streaming');
        await sleep(260);

        demo.classList.add('is-complete');
        stateLabel.textContent = 'Answered & solved';
        await sleep(4600);

        demo.classList.add('is-resetting');
        await sleep(360);
        demo.dataset.phase = 'compose';
        demo.classList.remove('is-complete');
        await sleep(80);
        demo.classList.remove('is-resetting');
      }
    };

    void play();
  }
</script>

