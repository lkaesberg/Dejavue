---
import Echo from './Echo.astro';

const question = 'How do I rotate an API key without downtime?';
const answer =
  'Create a second key in Settings → API, deploy it alongside the old one, then revoke the first after traffic has migrated. Both keys stay valid during the overlap, so there is no downtime.';
