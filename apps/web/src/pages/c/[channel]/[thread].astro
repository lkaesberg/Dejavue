---
import { tierLimits } from '@dejavue/core';
import {
  getDb,
  getDuplicatesOf,
  getPublishedThread,
  getPublishedThreads,
  getTopClusters,
  type Thread,
} from '@dejavue/db';
import ChannelRail from '../../../components/ChannelRail.astro';
import KbFooter from '../../../components/KbFooter.astro';
import KbNav from '../../../components/KbNav.astro';
import Base from '../../../layouts/Base.astro';
import { jsonForScript } from '../../../lib/jsonScript';
import { renderDiscordMarkdown, resolveMentions } from '../../../lib/discordText';
import { channelPath, extractThreadId, threadPath } from '../../../lib/slug';
import { brandOf, channelHandle, channelKind } from '../../../lib/theme';
import { publicOrigin } from '../../../lib/origin';

const { tenant, cfg, tier } = Astro.locals;
// The route is /c/{channel-slug}/{title-slug}-{snowflake}. Only the trailing
// id is the lookup key — both slugs are cosmetic and self-heal via redirect.
const threadId = extractThreadId(Astro.params.thread ?? '');
const origin = publicOrigin(Astro.request);
const limits = tierLimits(tier);

let thread: Thread | undefined;
let duplicates: { threadId: string; title: string }[] = [];
let related: Thread[] = [];
let channels: { id: string; name: string; count: number }[] = [];
let topics: { name: string; count: number; q: string }[] = [];
if (tenant && threadId) {
  const db = getDb();
  thread = await getPublishedThread(db, tenant.guildId, threadId);
  if (thread) {
    duplicates = await getDuplicatesOf(db, tenant.guildId, thread.threadId);
    const siblings = await getPublishedThreads(db, tenant.guildId, 1000);
    related = siblings
      .filter((t) => t.channelId === thread!.channelId && t.threadId !== thread!.threadId)
      .slice(0, 5);
    const m = new Map<string, { id: string; name: string; count: number }>();
    for (const t of siblings) {
      const e = m.get(t.channelId) ?? { id: t.channelId, name: t.channelName ?? 'General', count: 0 };
      e.count += 1;
      m.set(t.channelId, e);
    }
    channels = [...m.values()].sort((a, b) => b.count - a.count);
    if (limits.generative) {
      const clusters = await getTopClusters(db, tenant.guildId, 6);
      topics = clusters
        .filter((c) => c.label || c.representativeText)
        .map((c) => ({ name: c.label ?? c.representativeText ?? 'Topic', count: c.size, q: c.label ?? '' }));
    }
  }
}
if (!thread) Astro.response.status = 404;

// Legacy `/t/{id}` and stale-slug urls permanently redirect to the canonical
// slugged path, so old indexed links keep working and search engines converge.
if (thread && Astro.url.pathname !== threadPath(thread)) {
  return Astro.redirect(threadPath(thread), 301);
}

const summary = thread?.canonicalSummary ?? '';
const acceptedAnswer = thread?.acceptedAnswerText ?? '';
const transcript = thread?.transcript ?? [];
const acceptedMessageId = thread?.acceptedAnswerMessageId ?? null;
const channelName = thread?.channelName ?? '';
const hasContent = !!(acceptedAnswer || thread?.questionBody);
const brand = brandOf(cfg, tenant?.slug ?? undefined);

// Lazy AI summary: fetched over SSE on view (see the bottom script +
// /api/summary/[id].stream). The card shows for Pro/Max whenever there's content to
// summarize. A stored summary arrives in one frame; if none exists yet the route queues
// the worker to write one and this falls back to the raw answer until a later view.
const summaryPending = !!(thread && tenant && !summary && hasContent && limits.generative);
const showSummaryCard = limits.generative && (!!summary || summaryPending);
const isSolved = thread?.status === 'solved';
const bestAnswer = acceptedAnswer || summary || (thread?.questionBody ?? '');
const discordUrl =
  thread && tenant ? `https://discord.com/channels/${tenant.guildId}/${thread.threadId}` : '#';

// Privacy-preserving speaker aliases.
const labels = new Map<string, string>();
let helperCount = 0;
for (const m of transcript) {
  if (labels.has(m.authorId)) continue;
  if (thread && m.authorId === thread.opUserId) labels.set(m.authorId, 'Original poster');
  else labels.set(m.authorId, `Helper ${++helperCount}`);
}
const aliasOf = (id: string): string => labels.get(id) ?? 'Member';
// Mentioned users get the same anonymization as speakers ("@Original poster",
// "@Helper 2"); a mentioned non-participant falls back to "@Member".
const clean = (s: string): string => resolveMentions(s, aliasOf);
// Render Discord markdown (bold/italic/code/links) to safe HTML for display; `clean`
// stays plain text for meta/JSON-LD/filter indexes.
const md = (s: string): string => renderDiscordMarkdown(s, aliasOf);
const askUrl =
  thread && tenant ? `https://discord.com/channels/${tenant.guildId}/${thread.channelId}` : discordUrl;
const avatarOf = (id: string): { initial: string; bg: string } =>
  thread && id === thread.opUserId
    ? { initial: 'O', bg: 'linear-gradient(135deg,#F0883E,#E0632C)' }
    : { initial: 'H', bg: 'linear-gradient(135deg,#4F46E5,#7C3AED)' };
const fmtTime = (d: string): string =>
  new Date(d).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
const fmtDate = (d: Date | string | null | undefined): string =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const fmtBytes = (n: number | undefined): string =>
  !n ? '' : n < 1024 ? `${n} B` : n < 1048576 ? `${Math.round(n / 1024)} KB` : `${(n / 1048576).toFixed(1)} MB`;

const jsonLd = thread
  ? {
      '@context': 'https://schema.org',
      '@type': 'QAPage',
      mainEntity: {
        '@type': 'Question',
        name: thread.title,
        text: clean(thread.questionBody || thread.title),
        answerCount: bestAnswer ? 1 : 0,
        ...(bestAnswer ? { acceptedAnswer: { '@type': 'Answer', text: clean(bestAnswer) } } : {}),
      },
    }
  : null;
---

{
  thread ? (
    <Base
      title={`${thread.title} | ${brand}`}
      description={clean(thread.questionBody || thread.title).slice(0, 160)}
      canonical={`${origin}${threadPath(thread)}`}
      ogType="article"
      embedTagline={`${isSolved ? '✓ Solved' : 'Answer'}${channelName ? ` in ${channelHandle(channelName)}` : ''}`}
      embedButtons={[
        { label: 'Read the answer', url: `${origin}${threadPath(thread)}` },
        { label: 'Open in Discord', url: discordUrl },
        { label: 'Search answers', url: `${origin}/search` },
      ]}
    >
      {/* jsonForScript, not JSON.stringify: the question and answer are user-written, and
          a raw `</script>` in either would close this element and inject markup. */}
      <script type="application/ld+json" is:inline set:html={jsonForScript(jsonLd)} slot="head" />
      <KbNav query="" />
      <div class="kb-inner">
        <ChannelRail channels={channels} activeChannelId={thread.channelId} topics={topics} isPaid={limits.generative} />
        <main class="kb-main" id="kb-main" tabindex="-1">
          <div class="kb-article">
            {/* main column */}
            <div style="min-width:0; padding:26px clamp(0px,3vw,32px) 44px 0;">
            <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--textmut); flex-wrap:wrap;">
              <a href="/" class="kb-link">Help Center</a>
              {channelName && (<><span style="color:var(--border2);">/</span><a href={channelPath(thread)} class="kb-link">{channelName}</a></>)}
              <span style="color:var(--border2);">/</span><span style="color:var(--textmid);">{thread.title.slice(0, 40)}</span>
            </div>

            <div style="display:flex; align-items:center; gap:8px; margin-top:20px; flex-wrap:wrap;">
              {channelName && (
                <span style="background:var(--accentsoft); color:var(--accentline); font-size:12px; font-weight:600; padding:5px 11px; border-radius:999px;">{channelName}</span>
              )}
              {thread.channelId && (() => {
                const kind = channelKind(cfg, thread.channelId);
                return <span style={`font-size:12px; font-weight:600; padding:5px 11px; border-radius:999px; background:${kind.bg}; color:${kind.fg};`}>{kind.label}</span>;
              })()}
              {isSolved && (
                <span style="display:inline-flex; align-items:center; gap:6px; background:var(--solvedbg); color:var(--solvedfg); font-size:12px; font-weight:600; padding:5px 11px; border-radius:999px;">✓ Solved</span>
              )}
            </div>

            <h1 style="font-family:var(--headfont); font-weight:700; font-size:clamp(25px,3.4vw,31px); letter-spacing:-0.025em; line-height:1.2; margin:16px 0 0; color:var(--text);">{thread.title}</h1>
            <div style="display:flex; align-items:center; gap:14px; margin-top:13px; font-size:13px; color:var(--textmut); flex-wrap:wrap;">
              <span>Asked by <span style="color:var(--textmid);">Original poster</span></span>
              {thread.solvedAt && (<><span style="width:3px; height:3px; border-radius:50%; background:var(--border2);"></span><span>Resolved {fmtDate(thread.solvedAt)}</span></>)}
              {transcript.length > 0 && (<><span style="width:3px; height:3px; border-radius:50%; background:var(--border2);"></span><span>{`${transcript.length} ${transcript.length === 1 ? 'reply' : 'replies'}`}</span></>)}
              <span style="width:3px; height:3px; border-radius:50%; background:var(--border2);"></span>
              <a class="kb-link" href={discordUrl} target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:5px; color:var(--accentline); font-weight:500;">View on Discord ↗</a>
            </div>

            {/* AI summary (Pro/Max) */}
            {showSummaryCard && (
              <div style="margin-top:26px; border:1px solid var(--border2); background:linear-gradient(180deg,var(--accentsoft),var(--surface)); border-radius:var(--rad); padding:22px 24px;">
                <div style="display:flex; align-items:center; gap:9px;">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M12 2l2.4 5.8L20 9l-4.5 4 1.3 6L12 16l-4.8 3 1.3-6L4 9l5.6-1.2z"></path></svg>
                  <span style="font-family:var(--headfont); font-weight:600; font-size:14px; color:var(--accentline);">Summary</span>
                  <span style="margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.06em; color:#fff; background:linear-gradient(135deg,var(--accent),var(--accent2)); padding:3px 8px; border-radius:999px;">AI-GENERATED</span>
                </div>
                <p
                  id="kb-summary"
                  data-thread={thread.threadId}
                  data-pending={summaryPending ? 'true' : 'false'}
                  style="font-size:15.5px; line-height:1.65; color:var(--text); margin:14px 0 0; white-space:pre-wrap;"
                >{summary ? clean(summary) : 'Generating a summary…'}</p>
              </div>
            )}

            {/* accepted answer */}
            {acceptedAnswer && (
              <div style="margin-top:22px; border:1px solid var(--ansborder); background:var(--ansbg); border-radius:var(--rad); padding:22px 24px;">
                <div style="display:flex; align-items:center; gap:9px;">
                  <span style="display:inline-flex; align-items:center; justify-content:center; width:23px; height:23px; border-radius:50%; background:var(--solvedfg); color:#fff; font-size:13px; font-weight:700;">✓</span>
                  <span style="font-family:var(--headfont); font-weight:600; font-size:14px; color:var(--solvedfg);">Accepted answer</span>
                </div>
                <div style="font-size:15.5px; line-height:1.65; color:var(--text); margin:15px 0 0; white-space:pre-wrap;" set:html={md(acceptedAnswer)} />
              </div>
            )}

            {!limits.kbSummarizedAnswers && (
              <div style="font-size:12.5px; color:var(--textmut); margin-top:12px; line-height:1.5;">Raw thread transcript. <span style="color:var(--accentline);">Pro &amp; Max</span> add a clean AI summary at the top of every answer.</div>
            )}

            {transcript.length > 0 && (
              <div style="margin-top:32px;">
                <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
                  <h2 style="margin:0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Full discussion</h2>
                  <div style="display:flex; align-items:center; gap:8px; background:var(--inputbg); border:1px solid var(--border); border-radius:var(--radsm); padding:6px 11px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.3" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
                    <input id="kb-msg-filter" type="search" placeholder="Filter messages…" aria-label="Filter messages" style="border:none; outline:none; background:transparent; font-size:12.5px; color:var(--text); width:150px;" />
                  </div>
                </div>
                <div id="kb-msgs" style="display:flex; flex-direction:column; gap:18px; margin-top:18px;">
                  {transcript.map((m) => {
                    const accepted = !!m.id && m.id === acceptedMessageId;
                    const atts = m.attachments ?? [];
                    const filterText = [clean(m.content), ...atts.map((a) => a.name)].join(' ').toLowerCase();
                    return (
                      <div class="kb-msg" data-msg={filterText} style="display:flex; gap:13px;">
                        <div style={`width:34px; height:34px; border-radius:50%; background:${avatarOf(m.authorId).bg}; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:13px; font-weight:600;`}>{avatarOf(m.authorId).initial}</div>
                        <div style="flex:1; min-width:0;">
                          <div style="display:flex; align-items:center; gap:9px; flex-wrap:wrap;">
                            <span style="font-weight:600; font-size:14px; color:var(--text); white-space:nowrap;">{aliasOf(m.authorId)}</span>
                            <span style="font-size:12px; color:var(--textmut); white-space:nowrap;">{fmtTime(m.createdAt)}</span>
                            {accepted && (
                              <span style="display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; color:var(--solvedfg); background:var(--solvedbg); padding:2px 8px; border-radius:999px;">✓ Accepted answer</span>
                            )}
                          </div>
                          {m.content && (
                            <div style={`font-size:14px; line-height:1.6; color:${accepted ? 'var(--text)' : 'var(--textmid)'}; margin-top:4px; white-space:pre-wrap;${accepted ? ' border-left:3px solid #2DD4BF; background:var(--ansbg); border-radius:0 8px 8px 0; padding:10px 14px;' : ''}`} set:html={md(m.content)} />
                          )}
                          {atts.length > 0 && (
                            <div style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                              {atts.map((a) =>
                                a.kind === 'image' ? (
                                  <a href={`/a/${a.id}`} target="_blank" rel="noopener">
                                    <img
                                      class="kb-att-img"
                                      src={`/a/${a.id}`}
                                      data-fb={a.url ?? ''}
                                      alt={a.name}
                                      loading="lazy"
                                      style="max-width:min(100%,460px); height:auto; border-radius:var(--radsm); border:1px solid var(--border); display:block;"
                                    />
                                  </a>
                                ) : (
                                  <a
                                    href={a.url ?? '#'}
                                    target="_blank"
                                    rel="noopener"
                                    style="display:inline-flex; align-items:center; gap:9px; width:fit-content; max-width:100%; background:var(--surface2); border:1px solid var(--border); border-radius:var(--radsm); padding:9px 13px; font-size:13px; color:var(--text);"
                                  >
                                    <span style="font-size:15px;">{a.kind === 'video' ? '▶' : '📎'}</span>
                                    <span style="font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:300px;">{a.name}</span>
                                    {a.size ? <span style="color:var(--textmut); font-size:12px; white-space:nowrap;">{fmtBytes(a.size)}</span> : null}
                                  </a>
                                ),
                              )}
                            </div>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
                <div id="kb-msg-empty" hidden style="font-size:13px; color:var(--textmut); padding:12px 2px;">No messages match your filter.</div>
              </div>
            )}

            {transcript.length === 0 && thread.questionBody && (
              <div style="margin-top:30px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600;">{acceptedAnswer ? 'Question' : 'Details'}</div>
                <div style="font-size:15px; line-height:1.65; color:var(--textmid); margin-top:12px; white-space:pre-wrap;" set:html={md(thread.questionBody)} />
              </div>
            )}

            {(channelName || thread.labels.length > 0) && (
              <div style="display:flex; align-items:center; gap:8px; margin-top:32px; padding-top:24px; border-top:1px solid var(--border); flex-wrap:wrap;">
                {channelName && (
                  <a href={channelPath(thread)} style="background:var(--accentsoft); color:var(--accentline); font-size:12px; font-weight:500; padding:5px 11px; border-radius:999px;">{channelName}</a>
                )}
                {thread.labels.map((l) => (
                  <a href={`${channelPath(thread)}?label=${encodeURIComponent(l)}`} style="background:var(--chipbg); color:var(--chiptext); font-size:12px; font-weight:500; padding:5px 11px; border-radius:999px;">{l}</a>
                ))}
              </div>
            )}

            {/* Still-stuck escape hatch: route unresolved visitors back to the source channel to ask. */}
            <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-top:28px; padding:16px 18px; border:1px solid var(--border2); border-radius:var(--rad); background:var(--surface2);">
              <span style="font-size:14px; color:var(--textmid);">Didn't find your answer?</span>
              <a href={askUrl} target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:7px; font-size:14px; font-weight:600; color:#fff; background:linear-gradient(135deg,var(--accent),var(--accent2)); padding:9px 16px; border-radius:var(--radsm); white-space:nowrap;">Ask on Discord ↗</a>
            </div>
          </div>

          {/* sidebar */}
          <aside style="min-width:0; padding:34px 0 24px;">
            {related.length > 0 && (
              <>
                <h2 style="margin:0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Related</h2>
                <div style="display:flex; flex-direction:column; gap:3px; margin-top:13px;">
                  {related.map((r) => (
                    <a href={threadPath(r)} class="kb-row" style="display:flex; gap:9px; padding:11px 12px; border-radius:var(--radsm); align-items:flex-start;">
                      <span style="color:#2DD4BF; font-size:13px; margin-top:1px;">✓</span>
                      <span style="font-size:13.5px; line-height:1.4; color:var(--textmid);">{r.title}</span>
                    </a>
                  ))}
                </div>
              </>
            )}
            {duplicates.length > 0 && (
              <div style={related.length > 0 ? 'margin-top:24px;' : ''}>
                <h2 style="margin:0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Also asked as</h2>
                <div style="display:flex; flex-direction:column; gap:9px; margin-top:13px;">
                  {duplicates.map((d) => (
                    <a class="kb-link" href={`https://discord.com/channels/${tenant!.guildId}/${d.threadId}`} target="_blank" rel="noopener" style="display:flex; gap:7px; font-size:13px; line-height:1.4; color:var(--accentline);">
                      <span>{d.title}</span><span style="color:var(--textmut); flex-shrink:0;">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {limits.mcp && (
              <a href="/connect" class="kb-card-hover" style="display:block; margin-top:20px; padding:17px; border:1px solid var(--border2); border-radius:var(--rad); background:linear-gradient(160deg,var(--accentsoft),var(--surface));">
                <div style="display:flex; align-items:center; gap:7px;">
                  <span style="width:6px; height:6px; border-radius:50%; background:#2DD4BF;"></span>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--accentline); font-weight:600;">MCP · Max</span>
                </div>
                <div style="font-size:12.5px; color:var(--textmid); line-height:1.5; margin-top:8px;">Query this knowledge base from Claude, Cursor &amp; more. <span style="color:var(--accentline); font-weight:600;">View setup →</span></div>
              </a>
            )}
            </aside>
          </div>
        </main>
      </div>

      <KbFooter note={channelName ? `in ${channelName}` : ''} />

      {transcript.length > 0 && (
        <script is:inline>
          (function () {
            // If a re-hosted image 404s (re-host failed), fall back to the Discord url.
            document.querySelectorAll('img.kb-att-img').forEach(function (img) {
              var fb = function () { img.onerror = null; if (img.dataset.fb) img.src = img.dataset.fb; };
              img.onerror = fb;
              if (img.complete && img.naturalWidth === 0) fb();
            });
            var input = document.getElementById('kb-msg-filter');
            if (!input) return;
            var list = document.getElementById('kb-msgs');
            var empty = document.getElementById('kb-msg-empty');
            input.addEventListener('input', function () {
              var q = input.value.trim().toLowerCase();
              var shown = 0;
              list.querySelectorAll('.kb-msg').forEach(function (el) {
                var hit = !q || (el.getAttribute('data-msg') || '').indexOf(q) !== -1;
                el.style.display = hit ? 'flex' : 'none';
                if (hit) shown++;
              });
              if (empty) empty.hidden = shown !== 0;
            });
          })();
        </script>
      )}

      {summaryPending && (
        <script is:inline>
          (function () {
            var el = document.getElementById('kb-summary');
            if (!el || el.getAttribute('data-pending') !== 'true') return;
            var id = el.getAttribute('data-thread');
            var started = false;
            var queued = false;
            var es = new EventSource('/api/summary/' + encodeURIComponent(id) + '.stream');
            es.onmessage = function (e) {
              try {
                var d = JSON.parse(e.data);
                if (d && d.delta) {
                  if (!started) { el.textContent = ''; started = true; }
                  el.textContent += d.delta;
                }
              } catch (_) {}
            };
            // No stored summary yet: the server queued one for the worker to write.
            es.addEventListener('pending', function () { queued = true; });
            es.addEventListener('done', function () {
              es.close();
              el.removeAttribute('data-pending');
              if (!started && !el.textContent.trim()) {
                el.textContent = queued
                  ? 'A summary is being written for this answer — check back shortly.'
                  : 'No summary available.';
              }
            });
            es.onerror = function () { es.close(); };
          })();
        </script>
      )}
    </Base>
  ) : (
    <Base title="Answer not found" noindex>
      <div class="kb-bound" style="padding:80px 40px; text-align:center;">
        <h1 style="font-family:var(--headfont); font-weight:700; font-size:26px; letter-spacing:-0.03em;">Answer not found</h1>
        <p style="font-size:15px; color:var(--textmid); margin:12px 0 0;"><a href="/" class="kb-link" style="color:var(--accentline);">Back to the knowledge base</a></p>
      </div>
    </Base>
  )
}
