---
import { tierLimits } from '@dejavue/core';
import {
  channelGuidelinesOf,
  getDb,
  getPublishedThreads,
  getTopClusters,
  type Thread,
  type TranscriptMessage,
} from '@dejavue/db';
import ChannelRail from '../../components/ChannelRail.astro';
import KbFooter from '../../components/KbFooter.astro';
import KbNav from '../../components/KbNav.astro';
import Base from '../../layouts/Base.astro';
import { resolveMentions } from '../../lib/discordText';
import { channelPath, channelSlug, threadPath } from '../../lib/slug';
import { brandOf, channelHandle, channelKind } from '../../lib/theme';

const { tenant, cfg, tier } = Astro.locals;
const param = Astro.params.channel ?? '';
const url = new URL(Astro.request.url);
const origin = url.origin;
const labelParam = url.searchParams.get('label') ?? undefined;

let all: Thread[] = [];
let topics: { name: string; count: number; q: string }[] = [];
const isPaid = tierLimits(tier).generative;
if (tenant) {
  all = await getPublishedThreads(getDb(), tenant.guildId, 1000);
  if (isPaid) {
    const clusters = await getTopClusters(getDb(), tenant.guildId, 6);
    topics = clusters
      .filter((c) => c.label || c.representativeText)
      .map((c) => ({ name: c.label ?? c.representativeText ?? 'Topic', count: c.size, q: c.label ?? '' }));
  }
}

const channels = (() => {
  const m = new Map<string, { id: string; name: string; count: number }>();
  for (const t of all) {
    const e = m.get(t.channelId) ?? { id: t.channelId, name: t.channelName ?? 'General', count: 0 };
    e.count += 1;
    m.set(t.channelId, e);
  }
  return [...m.values()].sort((a, b) => b.count - a.count);
})();

// Resolve the route param: modern urls carry the slugified channel name
// (`/c/api-help`); legacy urls carry the raw snowflake and 301 below. If two
// channels somehow share a slug, the busiest one wins (deterministic).
const channelId = /^\d{15,21}$/.test(param)
  ? param
  : channels.filter((c) => channelSlug(c.name) === param).sort((a, b) => b.count - a.count)[0]?.id;

const threads = all.filter((t) => t.channelId === channelId);
const found = !!tenant && threads.length > 0;
if (!found) Astro.response.status = 404;

const channelName = threads[0]?.channelName ?? 'Channel';

// Legacy id urls and stale slugs (channel renames) redirect to the canonical
// slug path, keeping the label/view query intact.
const canonicalPath = channelPath({ name: channelName });
if (found && Astro.url.pathname !== canonicalPath) {
  return Astro.redirect(`${canonicalPath}${url.search}`, 301);
}

const guidelines = channelId ? channelGuidelinesOf(cfg, channelId) : undefined;
const kind = channelKind(cfg, channelId ?? '');

// Custom labels present in this channel, and the (optionally) label-filtered list.
const allLabels = [...new Set(threads.flatMap((t) => t.labels ?? []))].sort();
const shown = labelParam ? threads.filter((t) => (t.labels ?? []).includes(labelParam)) : threads;

const fmtDate = (d: Date | string | null): string =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '';
const snippetOf = (t: Thread): string => {
  const body = (t.canonicalSummary || t.acceptedAnswerText || t.questionBody || '').replace(/\s+/g, ' ').trim();
  return body.length > 200 ? `${body.slice(0, 200)}…` : body;
};

// Tracked normal channels (kind 'channel') offer a second "Chat" view: the whole
// conversation in chronological order, instead of the gap-grouped segment entries.
const isTracked = !!cfg?.trackedChannelIds?.includes(channelId ?? '');
const view = url.searchParams.get('view') === 'chat' && isTracked ? 'chat' : 'grouped';

const chatMsgs: TranscriptMessage[] =
  view === 'chat'
    ? (() => {
        const seen = new Set<string>();
        const merged: TranscriptMessage[] = [];
        for (const t of threads) {
          for (const m of t.transcript ?? []) {
            const key = m.id ?? `${m.authorId}:${m.createdAt}`;
            if (seen.has(key)) continue;
            seen.add(key);
            merged.push(m);
          }
        }
        merged.sort((a, b) => (Date.parse(a.createdAt) || 0) - (Date.parse(b.createdAt) || 0));
        return merged;
      })()
    : [];

// Privacy-preserving speaker aliases, stable across the whole channel.
const AVATAR_BGS = [
  'linear-gradient(135deg,#4F46E5,#7C3AED)',
  'linear-gradient(135deg,#0EA5E9,#2563EB)',
  'linear-gradient(135deg,#F0883E,#E0632C)',
  'linear-gradient(135deg,#10B981,#0F9B82)',
  'linear-gradient(135deg,#EC4899,#BE185D)',
];
const memberAlias = new Map<string, { name: string; bg: string }>();
for (const m of chatMsgs) {
  if (memberAlias.has(m.authorId)) continue;
  const n = memberAlias.size + 1;
  memberAlias.set(m.authorId, { name: `Member ${n}`, bg: AVATAR_BGS[(n - 1) % AVATAR_BGS.length]! });
}
const aliasOf = (id: string): string => memberAlias.get(id)?.name ?? 'Member';
// Mentioned users get the same anonymization as speakers ("@Member 3").
const clean = (s: string): string => resolveMentions(s, aliasOf);
const avatarBgOf = (id: string): string => memberAlias.get(id)?.bg ?? AVATAR_BGS[0]!;
const fmtTime = (d: string): string =>
  new Date(d).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
const fmtBytes = (n: number | undefined): string =>
  !n ? '' : n < 1024 ? `${n} B` : n < 1048576 ? `${Math.round(n / 1024)} KB` : `${(n / 1048576).toFixed(1)} MB`;
---

{
  found ? (
    <Base
      title={`${channelName} — ${brandOf(cfg, tenant?.slug ?? undefined)} Knowledge Base`}
      description={`${threads.length} solved answers in ${channelName}.`}
      canonical={`${origin}${canonicalPath}`}
    >
      <KbNav />
      <div class="kb-inner">
        <ChannelRail channels={channels} activeChannelId={channelId} topics={topics} isPaid={isPaid} />
        <main class="kb-main">
            <div style="padding:26px 0 40px;">
              <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--textmut);">
                <a href="/" class="kb-link">Help Center</a>
                <span style="color:var(--border2);">/</span>
                <span style="color:var(--textmid);">{channelName}</span>
              </div>
              <div style="display:flex; align-items:baseline; gap:13px; margin-top:14px; flex-wrap:wrap;">
                <h1 style="font-family:var(--headfont); font-weight:700; font-size:clamp(26px,3.4vw,32px); letter-spacing:-0.025em; margin:0; line-height:1; color:var(--text);">{channelName}</h1>
                <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accentline);">{channelHandle(channelName)}</span>
                <span style={`font-size:11px; font-weight:600; padding:3px 10px; border-radius:999px; background:${kind.bg}; color:${kind.fg};`}>{kind.label}</span>
                <span style="font-size:13px; color:var(--textmut);">· {threads.length} answers</span>
              </div>
              {guidelines && (
                <p style="font-size:15px; color:var(--textmid); margin:11px 0 0; line-height:1.55; white-space:pre-wrap;">{guidelines}</p>
              )}

              {/* search within this channel (chat view gets a compact one in the sticky bar) */}
              {view !== 'chat' && (
                <form action="/search" method="get" role="search" style="display:flex; align-items:center; gap:10px; margin-top:18px; background:var(--surface); border:1.5px solid var(--border2); border-radius:var(--rad); padding:11px 15px;">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
                  <input type="search" name="q" placeholder={`Search in ${channelName}…`} aria-label={`Search in ${channelName}`} style="flex:1; min-width:0; border:none; outline:none; background:transparent; font-size:14px; color:var(--text);" />
                  <input type="hidden" name="channel" value={channelId} />
                  <button type="submit" style="border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:12px; font-weight:600; padding:7px 13px; border-radius:var(--radsm);">Search</button>
                </form>
              )}

              {/* label filter (segment entries only — not the raw message stream) */}
              {view !== 'chat' && allLabels.length > 0 && (
                <div style="display:flex; align-items:center; gap:8px; margin-top:14px; flex-wrap:wrap;">
                  <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Labels</span>
                  <a href={canonicalPath} style={`font-size:12px; font-weight:600; padding:4px 11px; border-radius:999px; ${!labelParam ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>All</a>
                  {allLabels.map((l) => (
                    <a href={`${canonicalPath}?label=${encodeURIComponent(l)}`} style={`font-size:12px; font-weight:600; padding:4px 11px; border-radius:999px; ${labelParam === l ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>{l}</a>
                  ))}
                </div>
              )}

              {/* Tracked channels offer a chronological "chat" view next to the grouped one. */}
              {isTracked && (
                <div style="display:flex; align-items:center; gap:8px; margin-top:16px; flex-wrap:wrap;">
                  <a href={canonicalPath} style={`font-size:12px; font-weight:600; padding:5px 13px; border-radius:999px; ${view === 'grouped' ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>Conversations</a>
                  <a href={`${canonicalPath}?view=chat`} style={`font-size:12px; font-weight:600; padding:5px 13px; border-radius:999px; ${view === 'chat' ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>Chat view</a>
                  <span style="font-size:12px; color:var(--textmut);">{view === 'chat' ? 'Every message, in order' : 'Grouped by conversation (20-min gaps)'}</span>
                </div>
              )}

              {view === 'chat' ? (
                <div style="margin-top:12px;">
                  {/* compact sticky toolbar: count + channel search + live message filter */}
                  <div style="position:sticky; top:56px; z-index:10; background:var(--bg); display:flex; align-items:center; gap:9px; padding:9px 2px; border-bottom:1px solid var(--border); flex-wrap:wrap;">
                    <span style="font-size:12.5px; color:var(--textmut); white-space:nowrap;">{`${chatMsgs.length} ${chatMsgs.length === 1 ? 'message' : 'messages'}`}</span>
                    <form action="/search" method="get" role="search" style="display:flex; align-items:center; gap:7px; flex:1; min-width:130px; background:var(--surface); border:1px solid var(--border2); border-radius:var(--radsm); padding:5px 10px;">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
                      <input type="search" name="q" placeholder={`Search ${channelName}…`} aria-label={`Search in ${channelName}`} style="flex:1; min-width:0; border:none; outline:none; background:transparent; font-size:13px; color:var(--text);" />
                      <input type="hidden" name="channel" value={channelId} />
                    </form>
                    {chatMsgs.length > 0 && (
                      <div style="display:flex; align-items:center; gap:7px; background:var(--inputbg); border:1px solid var(--border); border-radius:var(--radsm); padding:5px 10px;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="6" y1="12" x2="18" y2="12" /><line x1="10" y1="18" x2="14" y2="18" /></svg>
                        <input id="kb-msg-filter" type="search" placeholder="Filter…" aria-label="Filter messages" style="border:none; outline:none; background:transparent; font-size:12.5px; color:var(--text); width:110px;" />
                      </div>
                    )}
                  </div>
                  <div id="kb-msgs" style="display:flex; flex-direction:column; gap:16px; padding-top:18px;">
                    {chatMsgs.map((m) => {
                      const filterText = [clean(m.content), aliasOf(m.authorId), ...(m.attachments ?? []).map((a) => a.name)]
                        .join(' ')
                        .toLowerCase();
                      return (
                        <div class="kb-msg" data-msg={filterText} style="display:flex; gap:13px;">
                          <div style={`width:34px; height:34px; border-radius:50%; background:${avatarBgOf(m.authorId)}; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:13px; font-weight:600;`}>M</div>
                          <div style="flex:1; min-width:0;">
                            <div style="display:flex; align-items:center; gap:9px; flex-wrap:wrap;">
                              <span style="font-weight:600; font-size:14px; color:var(--text);">{aliasOf(m.authorId)}</span>
                              <span style="font-size:12px; color:var(--textmut);">{fmtTime(m.createdAt)}</span>
                            </div>
                            {m.content && (
                              <div style="font-size:14px; line-height:1.6; color:var(--textmid); margin-top:4px; white-space:pre-wrap;">{clean(m.content)}</div>
                            )}
                            {(m.attachments ?? []).length > 0 && (
                              <div style="display:flex; flex-direction:column; gap:8px; margin-top:8px;">
                                {(m.attachments ?? []).map((a) =>
                                  a.kind === 'image' ? (
                                    <a href={`/a/${a.id}`} target="_blank" rel="noopener">
                                      <img class="kb-att-img" src={`/a/${a.id}`} data-fb={a.url ?? ''} alt={a.name} loading="lazy" style="max-width:min(100%,460px); height:auto; border-radius:var(--radsm); border:1px solid var(--border); display:block;" />
                                    </a>
                                  ) : (
                                    <a href={a.url ?? '#'} target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:9px; width:fit-content; max-width:100%; background:var(--surface2); border:1px solid var(--border); border-radius:var(--radsm); padding:9px 13px; font-size:13px; color:var(--text);">
                                      <span style="font-size:15px;">{a.kind === 'video' ? '▶' : '📎'}</span>
                                      <span style="font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:300px;">{a.name}</span>
                                      {a.size ? <span style="color:var(--textmut); font-size:12px; white-space:nowrap;">{fmtBytes(a.size)}</span> : null}
                                    </a>
                                  ),
                                )}
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                  <div id="kb-msg-empty" hidden style="font-size:13px; color:var(--textmut); padding:12px 2px;">No messages match your filter.</div>
                  {chatMsgs.length === 0 && (
                    <p style="font-size:14px; color:var(--textmut); padding:18px 2px;">No messages indexed yet.</p>
                  )}
                </div>
              ) : (
                <>
                  <div style="display:flex; align-items:center; justify-content:space-between; padding:18px 2px 12px; margin-top:14px; border-bottom:1px solid var(--border);">
                    <span style="font-size:13px; color:var(--textmut);">{shown.length} {shown.length === 1 ? 'answer' : 'answers'}{labelParam ? ` · ${labelParam}` : ''}</span>
                    <span style="font-size:13px; color:var(--textmid); font-weight:500;">Most recent</span>
                  </div>
                  {shown.map((q) => (
                    <a href={threadPath(q)} class="kb-row" style="display:flex; gap:14px; padding:17px 2px; border-bottom:1px solid var(--border);">
                      <span style="color:#2DD4BF; font-size:15px; margin-top:1px;">✓</span>
                      <div style="flex:1; min-width:0;">
                        <div style="font-family:var(--headfont); font-weight:600; font-size:16px; letter-spacing:-0.01em; color:var(--text);">{q.title}</div>
                        {snippetOf(q) && (
                          <div style="font-size:13.5px; color:var(--textmid); line-height:1.5; margin-top:4px;">{snippetOf(q)}</div>
                        )}
                        <div style="display:flex; align-items:center; gap:8px; margin-top:8px; flex-wrap:wrap;">
                          <span style="font-size:12px; color:var(--textmut);">
                            {q.status === 'solved' ? 'Solved' : 'Indexed'}
                            {q.solvedAt ? ` · ${fmtDate(q.solvedAt)}` : ''}
                            {(q.transcript?.length ?? 0) > 0 ? ` · ${q.transcript!.length} messages` : ''}
                          </span>
                          {(q.labels ?? []).map((l) => (
                            <span style="font-size:11px; font-weight:500; padding:2px 8px; border-radius:999px; background:var(--accentsoft); color:var(--accentline);">{l}</span>
                          ))}
                        </div>
                      </div>
                    </a>
                  ))}
                  {shown.length === 0 && (
                    <p style="font-size:14px; color:var(--textmut); padding:18px 2px;">No answers with the label “{labelParam}”.</p>
                  )}
                </>
              )}
            </div>
        </main>
      </div>
      <KbFooter note={`${channels.length} channels · ${all.length} answers`} />
      {view === 'chat' && (
        <script is:inline>
          (function () {
            document.querySelectorAll('img.kb-att-img').forEach(function (img) {
              var fb = function () { img.onerror = null; if (img.dataset.fb) img.src = img.dataset.fb; };
              img.onerror = fb;
              if (img.complete && img.naturalWidth === 0) fb();
            });
            var input = document.getElementById('kb-msg-filter');
            if (!input) return;
            var list = document.getElementById('kb-msgs');
            var empty = document.getElementById('kb-msg-empty');
            input.addEventListener('input', function () {
              var q = input.value.trim().toLowerCase();
              var shown = 0;
              list.querySelectorAll('.kb-msg').forEach(function (el) {
                var hit = !q || (el.getAttribute('data-msg') || '').indexOf(q) !== -1;
                el.style.display = hit ? 'flex' : 'none';
                if (hit) shown++;
              });
              if (empty) empty.hidden = shown !== 0;
            });
          })();
        </script>
      )}
    </Base>
  ) : (
    <Base title="Channel not found" noindex>
      <div class="kb-bound" style="padding:80px 40px; text-align:center;">
        <h1 style="font-family:var(--headfont); font-weight:700; font-size:26px; letter-spacing:-0.03em;">Channel not found</h1>
        <p style="font-size:15px; color:var(--textmid); margin:12px 0 0;"><a href="/" class="kb-link" style="color:var(--accentline);">Back to the knowledge base</a></p>
      </div>
    </Base>
  )
}
