---
import { tierLimits } from '@dejavue/core';
import {
  channelGuidelinesOf,
  getDb,
  getPublishedThreads,
  getTopClusters,
  type Thread,
} from '@dejavue/db';
import ChannelRail from '../../components/ChannelRail.astro';
import KbFooter from '../../components/KbFooter.astro';
import KbNav from '../../components/KbNav.astro';
import Base from '../../layouts/Base.astro';
import { brandOf, channelHandle, channelKind } from '../../lib/theme';

const { tenant, cfg, tier } = Astro.locals;
const { channel } = Astro.params;
const url = new URL(Astro.request.url);
const origin = url.origin;
const labelParam = url.searchParams.get('label') ?? undefined;

let all: Thread[] = [];
let topics: { name: string; count: number; q: string }[] = [];
const isPaid = tierLimits(tier).generative;
if (tenant) {
  all = await getPublishedThreads(getDb(), tenant.guildId, 1000);
  if (isPaid) {
    const clusters = await getTopClusters(getDb(), tenant.guildId, 6);
    topics = clusters
      .filter((c) => c.label || c.representativeText)
      .map((c) => ({ name: c.label ?? c.representativeText ?? 'Topic', count: c.size, q: c.label ?? '' }));
  }
}
const threads = all.filter((t) => t.channelId === channel);
const found = !!tenant && threads.length > 0;
if (!found) Astro.response.status = 404;

const channelName = threads[0]?.channelName ?? 'Channel';
const guidelines = channel ? channelGuidelinesOf(cfg, channel) : undefined;
const kind = channelKind(cfg, channel ?? '');

// Custom labels present in this channel, and the (optionally) label-filtered list.
const allLabels = [...new Set(threads.flatMap((t) => t.labels ?? []))].sort();
const shown = labelParam ? threads.filter((t) => (t.labels ?? []).includes(labelParam)) : threads;

const channels = (() => {
  const m = new Map<string, { id: string; name: string; count: number }>();
  for (const t of all) {
    const e = m.get(t.channelId) ?? { id: t.channelId, name: t.channelName ?? 'General', count: 0 };
    e.count += 1;
    m.set(t.channelId, e);
  }
  return [...m.values()].sort((a, b) => b.count - a.count);
})();

const fmtDate = (d: Date | string | null): string =>
  d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
const snippetOf = (t: Thread): string => {
  const body = (t.canonicalSummary || t.acceptedAnswerText || t.questionBody || '').replace(/\s+/g, ' ').trim();
  return body.length > 200 ? `${body.slice(0, 200)}…` : body;
};
---

{
  found ? (
    <Base
      title={`${channelName} — ${brandOf(cfg, tenant?.slug ?? undefined)} Knowledge Base`}
      description={`${threads.length} solved answers in ${channelName}.`}
      canonical={`${origin}/c/${channel}`}
    >
      <KbNav />
      <div class="kb-inner">
        <ChannelRail channels={channels} activeChannelId={channel} topics={topics} isPaid={isPaid} />
        <main class="kb-main">
            <div style="padding:26px 0 40px;">
              <div style="display:flex; align-items:center; gap:8px; font-size:13px; color:var(--textmut);">
                <a href="/" class="kb-link">Help Center</a>
                <span style="color:var(--border2);">/</span>
                <span style="color:var(--textmid);">{channelName}</span>
              </div>
              <div style="display:flex; align-items:baseline; gap:13px; margin-top:14px; flex-wrap:wrap;">
                <h1 style="font-family:var(--headfont); font-weight:700; font-size:clamp(26px,3.4vw,32px); letter-spacing:-0.025em; margin:0; line-height:1; color:var(--text);">{channelName}</h1>
                <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--accentline);">{channelHandle(channelName)}</span>
                <span style={`font-size:11px; font-weight:600; padding:3px 10px; border-radius:999px; background:${kind.bg}; color:${kind.fg};`}>{kind.label}</span>
                <span style="font-size:13px; color:var(--textmut);">· {threads.length} answers</span>
              </div>
              {guidelines && (
                <p style="font-size:15px; color:var(--textmid); margin:11px 0 0; line-height:1.55; white-space:pre-wrap;">{guidelines}</p>
              )}

              {/* search within this channel */}
              <form action="/search" method="get" role="search" style="display:flex; align-items:center; gap:10px; margin-top:18px; background:var(--surface); border:1.5px solid var(--border2); border-radius:var(--rad); padding:11px 15px;">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
                <input type="search" name="q" placeholder={`Search in ${channelName}…`} aria-label={`Search in ${channelName}`} style="flex:1; min-width:0; border:none; outline:none; background:transparent; font-size:14px; color:var(--text);" />
                <input type="hidden" name="channel" value={channel} />
                <button type="submit" style="border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:12px; font-weight:600; padding:7px 13px; border-radius:var(--radsm);">Search</button>
              </form>

              {/* label filter */}
              {allLabels.length > 0 && (
                <div style="display:flex; align-items:center; gap:8px; margin-top:14px; flex-wrap:wrap;">
                  <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--textmut); font-weight:600;">Labels</span>
                  <a href={`/c/${channel}`} style={`font-size:12px; font-weight:600; padding:4px 11px; border-radius:999px; ${!labelParam ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>All</a>
                  {allLabels.map((l) => (
                    <a href={`/c/${channel}?label=${encodeURIComponent(l)}`} style={`font-size:12px; font-weight:600; padding:4px 11px; border-radius:999px; ${labelParam === l ? 'background:var(--accent); color:#fff;' : 'background:var(--chipbg); color:var(--chiptext);'}`}>{l}</a>
                  ))}
                </div>
              )}

              <div style="display:flex; align-items:center; justify-content:space-between; padding:18px 2px 12px; margin-top:14px; border-bottom:1px solid var(--border);">
                <span style="font-size:13px; color:var(--textmut);">{shown.length} {shown.length === 1 ? 'answer' : 'answers'}{labelParam ? ` · ${labelParam}` : ''}</span>
                <span style="font-size:13px; color:var(--textmid); font-weight:500;">Most recent</span>
              </div>
              {shown.map((q) => (
                <a href={`/t/${q.threadId}`} class="kb-row" style="display:flex; gap:14px; padding:17px 2px; border-bottom:1px solid var(--border);">
                  <span style="color:#2DD4BF; font-size:15px; margin-top:1px;">✓</span>
                  <div style="flex:1; min-width:0;">
                    <div style="font-family:var(--headfont); font-weight:600; font-size:16px; letter-spacing:-0.01em; color:var(--text);">{q.title}</div>
                    {snippetOf(q) && (
                      <div style="font-size:13.5px; color:var(--textmid); line-height:1.5; margin-top:4px;">{snippetOf(q)}</div>
                    )}
                    <div style="display:flex; align-items:center; gap:8px; margin-top:8px; flex-wrap:wrap;">
                      <span style="font-size:12px; color:var(--textmut);">
                        {q.status === 'solved' ? 'Solved' : 'Indexed'}
                        {q.solvedAt ? ` · ${fmtDate(q.solvedAt)}` : ''}
                        {(q.transcript?.length ?? 0) > 0 ? ` · ${q.transcript!.length} messages` : ''}
                      </span>
                      {(q.labels ?? []).map((l) => (
                        <span style="font-size:11px; font-weight:500; padding:2px 8px; border-radius:999px; background:var(--accentsoft); color:var(--accentline);">{l}</span>
                      ))}
                    </div>
                  </div>
                </a>
              ))}
              {shown.length === 0 && (
                <p style="font-size:14px; color:var(--textmut); padding:18px 2px;">No answers with the label “{labelParam}”.</p>
              )}
            </div>
        </main>
      </div>
      <KbFooter note={`${channels.length} channels · ${all.length} answers`} />
    </Base>
  ) : (
    <Base title="Channel not found" noindex>
      <div class="kb-bound" style="padding:80px 40px; text-align:center;">
        <h1 style="font-family:var(--headfont); font-weight:700; font-size:26px; letter-spacing:-0.03em;">Channel not found</h1>
        <p style="font-size:15px; color:var(--textmid); margin:12px 0 0;"><a href="/" class="kb-link" style="color:var(--accentline);">Back to the knowledge base</a></p>
      </div>
    </Base>
  )
}
