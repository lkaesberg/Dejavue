            <Echo tile="gradient" round={false} size={64} style="margin:0 auto; border-radius:16px; box-shadow:0 14px 36px rgba(124,58,237,0.4);" />
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(30px,6vw,44px); letter-spacing:-0.03em; margin:26px 0 0; line-height:1.05;">Stop answering the same question twice.</h2>
            <div style="display:flex; gap:14px; justify-content:center; margin-top:32px; flex-wrap:wrap;">
              <a href={addUrl} style="display:inline-flex; align-items:center; gap:9px; background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#F4F5FF; font-size:15px; font-weight:600; padding:16px 30px; border-radius:12px; box-shadow:0 12px 30px rgba(124,58,237,0.4);">Add to Discord — free</a>
              <a href="https://github.com" style="display:inline-flex; align-items:center; gap:9px; background:rgba(244,245,255,0.05); border:1px solid rgba(244,245,255,0.16); color:#F4F5FF; font-size:15px; font-weight:600; padding:16px 30px; border-radius:12px;">Read the docs</a>
            </div>
          </div>
        </div>
      </section>

      {/* ===== FOOTER ===== */}
      <footer style="border-top:1px solid rgba(244,245,255,0.07); padding:40px clamp(16px,4vw,32px);">
        <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;">
          <div style="display:flex; align-items:center; gap:10px;">
            <Echo tile="none" bubbleFill="#F4F5FF" checkFill="#2DD4BF" showEcho={false} size={22} />
            <span style="font-family:'Space Grotesk',sans-serif; font-weight:500; font-size:16px; letter-spacing:-0.03em;">dejavue</span>
            <span style="font-size:13px; color:#6F7596; margin-left:8px;">Déjà vu, handled.</span>
          </div>
          <div style="display:flex; gap:24px; font-size:13px; color:#9AA0C3; flex-wrap:wrap;">
            <a href="https://github.com" style="color:#9AA0C3;">Docs</a>
            <a href="https://github.com" style="color:#9AA0C3;">GitHub</a>
            <a href="#" style="color:#9AA0C3;">Privacy</a>
            <a href="#" style="color:#9AA0C3;">Status</a>
