---
import { getEnv } from '@dejavue/core';
import { channelGuidelinesOf, getDb, getPublishedThreads, type Thread } from '@dejavue/db';
import AssistantDemo from '../components/AssistantDemo.astro';
import DiscordIcon from '../components/DiscordIcon.astro';
import Echo from '../components/Echo.astro';
import GitHubIcon from '../components/GitHubIcon.astro';
import HeroDemo from '../components/HeroDemo.astro';
import KbFooter from '../components/KbFooter.astro';
import KbNav from '../components/KbNav.astro';
import PublicSiteDemo from '../components/PublicSiteDemo.astro';
import SearchDemo from '../components/SearchDemo.astro';
import Base from '../layouts/Base.astro';
import { channelPath, threadPath } from '../lib/slug';
import SiteLayout from '../layouts/SiteLayout.astro';
import { brandOf, channelDot, channelHandle, channelKind } from '../lib/theme';
import { jsonForScript } from '../lib/jsonScript';
import { publicOrigin } from '../lib/origin';

const { tenant, slug } = Astro.locals;
const notFound = slug !== null && tenant === null;
if (notFound) Astro.response.status = 404;

const origin = publicOrigin(Astro.request);
const env = getEnv();

// ---- Tenant KB home data -------------------------------------------------
let threads: Thread[] = [];
const cfg = Astro.locals.cfg;
if (tenant) {
  threads = await getPublishedThreads(getDb(), tenant.guildId, 1000);
}
const brand = brandOf(cfg, tenant?.slug ?? undefined);

const byChannel = new Map<string, { id: string; name: string; count: number }>();
for (const t of threads) {
  const entry = byChannel.get(t.channelId) ?? { id: t.channelId, name: t.channelName ?? 'General', count: 0 };
  entry.count += 1;
  byChannel.set(t.channelId, entry);
}
const categories = [...byChannel.values()].sort((a, b) => b.count - a.count);
const mostAsked = threads.slice(0, 5);
// Popular-search chips derived from the most recent answers (first few words).
const chips = mostAsked.slice(0, 4).map((t) => {
  const words = t.title.replace(/[?.!]/g, '').split(/\s+/).slice(0, 4).join(' ');
  return { label: words, q: t.title };
});
const handle = channelHandle;

// ---- Add-to-Discord install link (marketing) ------------------------------
const PERMS = (
  1024n /* View Channels */ +
  16n /* Manage Channels */ +
  2048n /* Send Messages */ +
  16384n /* Embed Links */ +
  65536n /* Read Message History */ +
  17179869184n /* Manage Threads */ +
  274877906944n /* Send Messages in Threads */
).toString();
const addUrl = env.DISCORD_CLIENT_ID
  ? `https://discord.com/oauth2/authorize?client_id=${env.DISCORD_CLIENT_ID}&scope=bot+applications.commands&permissions=${PERMS}`
  : '#';

// ---- Open source ----------------------------------------------------------
// Dejavue is AGPL-3.0. The privacy argument on this page ("we don't track you",
// "authors stay aliased") is only worth as much as it is checkable, so link the
// source prominently rather than burying it in the footer.
const repoUrl = 'https://github.com/lkaesberg/Dejavue';

// ---- Marketing static content --------------------------------------------
const featBtn =
  'background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#F4F5FF; box-shadow:0 10px 24px rgba(124,58,237,0.35);';
const ghostBtn = 'background:rgba(244,245,255,0.06); border:1px solid rgba(244,245,255,0.16); color:#F4F5FF;';
// AI usage is metered in AI credits: 1 credit = 1,000 model tokens (a drafted
// answer ≈ 0.8 credits, a thread summary ≈ 3). Keep in sync with README + core.
const tiers = [
  { name: 'Free', price: '€0', per: '', tag: 'The full search experience, on a small archive.', bg: 'rgba(27,29,51,0.45)', border: 'rgba(244,245,255,0.08)', pill: '', pillStyle: '', cta: 'Add to Discord', btnStyle: ghostBtn, feats: ['3 forum channels', '3 tracked text channels', 'Semantic duplicate detection & search', 'Mark-solved + archive (2,500 messages)', 'Stale-question nudges · full analytics', 'Public website on your subdomain (shows one cookieless ad)'] },
  { name: 'Plus', price: '€4.99', per: '/mo', tag: 'Adds AI answers, summaries and your own branding.', bg: 'rgba(27,29,51,0.55)', border: 'rgba(244,245,255,0.1)', pill: '', pillStyle: '', cta: 'Choose Plus', btnStyle: ghostBtn, feats: ['15 forum channels', '15 tracked text channels', '25,000 indexed messages', 'AI-drafted answers · 250 credits / mo', 'AI summaries · clustering · auto-FAQ', 'AI-summarized website pages', 'Public website · no ads, no Dejavue branding'] },
  { name: 'Pro', price: '€9.99', per: '/mo', tag: 'Room to grow, plus your answers inside Claude & ChatGPT.', bg: 'linear-gradient(180deg, rgba(79,70,229,0.2), rgba(27,29,51,0.6))', border: 'rgba(167,139,250,0.4)', pill: 'MOST POPULAR', pillStyle: 'background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#fff;', cta: 'Choose Pro', btnStyle: featBtn, feats: ['50 forum channels', '50 tracked text channels', '250,000 indexed messages', '2,500 AI credits / mo (≈3,000 drafts)', 'Your answers inside Claude & ChatGPT (MCP)', 'Everything in Plus'] },
  { name: 'Max', price: '€24.99', per: '/mo', tag: 'Unlimited scale for the largest communities.', bg: 'rgba(27,29,51,0.55)', border: 'rgba(45,212,191,0.3)', pill: 'UNLIMITED', pillStyle: 'background:linear-gradient(135deg,#2DD4BF,#5EEAD4); color:#052E28;', cta: 'Choose Max', btnStyle: ghostBtn, feats: ['Unlimited channels & archive', 'Unlimited AI-summarized website pages', '12,000 AI credits / mo', 'Priority support', 'Everything in Pro'] },
];

// ---- SEO: title, description + JSON-LD structured data (marketing home) ----
// Keyword-forward for Google ("Discord", "duplicate question", "knowledge base")
// while staying truthful — Dejavue publishes solved threads to an opt-in public KB.
const pageTitle = 'Dejavue | Discord Duplicate Question Bot & Knowledge Base';
const pageDescription =
  'Dejavue is a Discord bot that catches duplicate questions, runs a mark-solved workflow, and turns solved threads into a public, searchable knowledge base.';
// One @graph so Google links the entities: Organization ← WebSite, and the
// SoftwareApplication that describes the product itself. Prices mirror the tiers
// above (Free €0 → Max €24.99); no ratings are claimed (none are real).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'Dejavue',
      url: `${origin}/`,
      logo: `${origin}/media/app-icon-2048.png`,
      description: pageDescription,
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      name: 'Dejavue',
      url: `${origin}/`,
      inLanguage: 'en',
      publisher: { '@id': `${origin}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${origin}/#software`,
      name: 'Dejavue',
      url: `${origin}/`,
      description: pageDescription,
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Discord Bot',
      operatingSystem: 'Discord, Web',
      publisher: { '@id': `${origin}/#organization` },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        lowPrice: '0',
        highPrice: '24.99',
        offerCount: 4,
      },
      featureList: [
        'Duplicate question detection',
        'Semantic search',
        'AI-drafted answers',
        'Mark-solved workflow',
        'Public, searchable knowledge base',
        'Open source (AGPL-3.0), self-hostable',
      ],
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      isAccessibleForFree: true,
      codeRepository: repoUrl,
    },
  ],
};
---

{
  tenant ? (
    <Base
      title={`${brand} Knowledge Base`}
      description={`Search ${brand}'s solved answers, kept up to date by the community.`}
      canonical={`${origin}/`}
    >
      <KbNav />

      {/* hero + search */}
      <div class="kb-hero">
        <div class="kb-hero-inner">
            <h1 style="font-family:var(--headfont); font-weight:700; font-size:clamp(30px,5.2vw,46px); letter-spacing:-0.03em; margin:0; line-height:1.06;">How can we help?</h1>
            <p style="font-size:clamp(15px,1.6vw,17px); color:var(--textmid); margin:13px 0 0;">Search {brand}'s solved answers, kept up to date by the community.</p>
            <form action="/search" method="get" role="search" style="display:flex; align-items:center; gap:12px; max-width:600px; margin:26px auto 0; background:var(--surface); border:1.5px solid var(--border2); border-radius:var(--rad); padding:15px 18px; box-shadow:0 10px 30px rgba(20,21,42,0.07);">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
              <input type="search" name="q" placeholder={`Search ${threads.length} answers…`} aria-label="Search the knowledge base" style="flex:1; min-width:0; border:none; outline:none; background:transparent; font-size:16px; color:var(--text);" />
              <button type="submit" style="border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:12.5px; font-weight:600; padding:8px 15px; border-radius:var(--radsm);">Search</button>
            </form>
            {chips.length > 0 && (
              <div style="display:flex; align-items:center; justify-content:center; gap:9px; margin-top:16px; flex-wrap:wrap;">
                <span style="font-size:12.5px; color:var(--textmut);">Popular:</span>
                {chips.map((ch) => (
                  <a href={`/search?q=${encodeURIComponent(ch.q)}`} style="font-size:12.5px; color:var(--accentline); background:var(--accentsoft); padding:5px 11px; border-radius:999px;">{ch.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>

        <main class="kb-home" id="kb-main" tabindex="-1">
          {/* most asked */}
          {mostAsked.length > 0 && (
            <>
              <h2 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600; margin:0 0 13px;">Most asked</h2>
              <div style="border:1px solid var(--border); border-radius:var(--rad); overflow:hidden; background:var(--surface);">
                {mostAsked.map((q) => (
                  <a href={threadPath(q)} class="kb-row" style="display:flex; align-items:center; gap:13px; padding:15px 18px; border-bottom:1px solid var(--border);">
                    <span style="color:#2DD4BF; font-size:14px;">✓</span>
                    <span style="font-size:14.5px; color:var(--text); flex:1; font-weight:500;">{q.title}</span>
                    {q.channelName && (
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--chiptext); background:var(--chipbg); padding:3px 9px; border-radius:999px; white-space:nowrap;">{q.channelName}</span>
                    )}
                  </a>
                ))}
              </div>
            </>
          )}

          {/* channels */}
          <h2 style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600; margin:30px 0 13px;">Channels</h2>
          {categories.length === 0 ? (
            <p style="font-size:14px; color:var(--textmut);">No published answers yet. Check back soon.</p>
          ) : (
            <div class="cat-grid">
              {categories.map((c) => {
                const guidelines = channelGuidelinesOf(cfg, c.id);
                const kind = channelKind(cfg, c.id);
                return (
                  <a href={channelPath(c)} class="kb-card-hover" style="border:1px solid var(--border); border-radius:var(--rad); padding:18px 20px; display:block; background:var(--surface);">
                    <div style="display:flex; align-items:center; justify-content:space-between;">
                      <span style="display:flex; align-items:center; gap:9px;">
                        <span style={`width:9px; height:9px; border-radius:50%; background:${channelDot(c.id)};`}></span>
                        <span style="font-family:var(--headfont); font-weight:600; font-size:16px; letter-spacing:-0.01em; color:var(--text);">{c.name}</span>
                      </span>
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--chiptext); background:var(--chipbg); padding:3px 9px; border-radius:999px;">{c.count}</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--accentline);">{handle(c.name)}</span>
                      <span style={`font-size:10px; font-weight:600; padding:2px 8px; border-radius:999px; background:${kind.bg}; color:${kind.fg};`}>{kind.label}</span>
                    </div>
                    {guidelines && (
                      <div style="font-size:13.5px; color:var(--textmid); margin-top:7px; line-height:1.45;">
                        {guidelines.length > 130 ? `${guidelines.slice(0, 130)}…` : guidelines}
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          )}
        </main>

        <KbFooter note={`Updated daily · ${threads.length} answers indexed`} />
    </Base>
  ) : notFound ? (
    <Base title="Knowledge base not found" noindex>
      <div class="kb-bound" style="padding-top:80px; padding-bottom:80px; text-align:center;">
        <Echo size={48} style="margin:0 auto;" />
        <h1 style="font-family:var(--headfont); font-weight:700; font-size:28px; letter-spacing:-0.03em; margin:24px 0 0;">Knowledge base not found</h1>
        <p style="font-size:15px; color:var(--textmid); margin:12px 0 0;">This community hasn't set up a public knowledge base.</p>
      </div>
    </Base>
  ) : (
    <SiteLayout title={pageTitle} description={pageDescription} canonical={`${origin}/`}>
      <script type="application/ld+json" is:inline set:html={jsonForScript(structuredData)} slot="head" />

      {/* ===== NAV ===== */}
      <nav style="position:sticky; top:0; z-index:50; backdrop-filter:blur(14px); background:rgba(10,11,20,0.72); border-bottom:1px solid rgba(244,245,255,0.07);">
        <div style="max-width:1200px; margin:0 auto; padding:14px clamp(16px,4vw,32px); display:flex; align-items:center; justify-content:space-between; gap:16px;">
          <div style="display:flex; align-items:center; gap:11px;">
            <Echo tile="none" bubbleFill="#F4F5FF" checkFill="#2DD4BF" echoFill="#A78BFA" echoOpacity={0.6} size={32} />
            <span style="font-family:'Space Grotesk',sans-serif; font-weight:500; font-size:21px; letter-spacing:-0.04em;">dejavue</span>
          </div>
          <div class="site-nav-links">
            <a href="#kb" style="font-size:14px; color:#9AA0C3;">Knowledge Base</a>
            <a href="#mcp" style="font-size:14px; color:#9AA0C3;">MCP</a>
            <a href="#pricing" style="font-size:14px; color:#9AA0C3;">Pricing</a>
            {/* Layout lives in .nav-icon-link, not inline: the mobile rule that hides
                non-CTA nav links sets `display:none`, which an inline display would win against. */}
            <a class="nav-icon-link" href={repoUrl} rel="noopener" style="font-size:14px; color:#9AA0C3;"><GitHubIcon size={15} />Source</a>
            <a class="cta" href={addUrl} style="display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:600; color:#F4F5FF; background:linear-gradient(135deg,#4F46E5,#7C3AED); padding:10px 18px; border-radius:10px; box-shadow:0 6px 18px rgba(124,58,237,0.35);"><DiscordIcon size={17} />Add to Discord</a>
          </div>
        </div>
      </nav>

      {/* ===== HERO ===== */}
      <header style="position:relative; padding:clamp(56px,9vw,96px) clamp(16px,4vw,32px) clamp(52px,8vw,88px);">
        <div style="position:absolute; top:-160px; right:-80px; width:680px; height:680px; border-radius:50%; background:radial-gradient(circle, rgba(124,58,237,0.32), rgba(79,70,229,0.08) 42%, rgba(10,11,20,0) 70%); pointer-events:none;"></div>
        <div style="position:absolute; top:120px; left:-180px; width:520px; height:520px; border-radius:50%; background:radial-gradient(circle, rgba(45,212,191,0.10), rgba(10,11,20,0) 68%); pointer-events:none;"></div>
        <div class="hero-grid" style="position:relative; max-width:1200px; margin:0 auto;">
          <div>
            <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(167,139,250,0.12); border:1px solid rgba(167,139,250,0.28); color:#C4B5FD; font-size:13px; font-weight:500; padding:7px 14px; border-radius:999px;">
              <span style="width:6px; height:6px; border-radius:50%; background:#2DD4BF; box-shadow:0 0 0 4px rgba(45,212,191,0.18);"></span>
              A Discord bot for help &amp; Q&amp;A forums
            </div>
            <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(34px,8vw,62px); line-height:1.02; letter-spacing:-0.038em; margin:24px 0 0;">Stop answering the same questions.</h1>
            <p style="font-size:clamp(16px,2.4vw,19px); line-height:1.55; color:#9AA0C3; margin:24px 0 0; max-width:520px;">Dejavue uses past solutions to answer duplicates, giving your moderators less work.</p>
            <div style="display:flex; gap:14px; margin-top:36px; flex-wrap:wrap;">
              <a href={addUrl} style="display:inline-flex; align-items:center; gap:9px; background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#F4F5FF; font-size:15px; font-weight:600; padding:15px 26px; border-radius:12px; box-shadow:0 12px 30px rgba(124,58,237,0.4);"><DiscordIcon />Add to Discord</a>
            </div>
            <div style="display:flex; align-items:center; gap:22px; margin-top:30px; color:#6F7596; font-size:13px; flex-wrap:wrap;">
              <span style="display:inline-flex; align-items:center; gap:7px;"><span style="color:#2DD4BF;">✓</span> Free tier, no card</span>
              <span style="display:inline-flex; align-items:center; gap:7px;"><span style="color:#2DD4BF;">✓</span> Live in under a minute</span>
              <a href="#open-source" style="display:inline-flex; align-items:center; gap:7px; color:#6F7596;"><span style="color:#2DD4BF;">✓</span> Open source</a>
            </div>
          </div>

          {/* Signature product loop: post → search → sourced answer → solved. */}
          <HeroDemo />
        </div>
      </header>

      {/* ===== KB SHOWCASE ===== */}
      <section id="kb" style="padding:clamp(48px,8vw,80px) clamp(16px,4vw,32px);">
        <div class="kb-grid" style="max-width:1200px; margin:0 auto;">
          <PublicSiteDemo />
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:#A78BFA; font-weight:500;">Your public website</div>
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,5vw,38px); letter-spacing:-0.03em; margin:14px 0 0;">A free FAQ your users can search</h2>
            <p style="font-size:16.5px; line-height:1.6; color:#9AA0C3; margin:18px 0 0;">Solved threads publish themselves to <span style="color:#C4B5FD; font-family:'JetBrains Mono',monospace; font-size:14px;">yourdomain.dejavue.app</span> (or your own domain), where your users and Google find them.</p>
            <ul style="list-style:none; padding:0; margin:26px 0 0; display:flex; flex-direction:column; gap:13px;">
              <li style="display:flex; gap:10px; font-size:15px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> Builds and updates itself</li>
              <li style="display:flex; gap:10px; font-size:15px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> Every answer ranks on Google</li>
              <li style="display:flex; gap:10px; font-size:15px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> Private by default: opt-in, aliased usernames</li>
            </ul>
            <SearchDemo />
          </div>
        </div>
      </section>

      {/* ===== AI ASSISTANT CALLOUT ===== */}
      <section id="mcp" style="padding:clamp(36px,6vw,48px) clamp(16px,4vw,32px);">
        <div style="max-width:1200px; margin:0 auto;">
          <div class="assistant-grid" style="position:relative; overflow:hidden; border-radius:24px; border:1px solid rgba(167,139,250,0.22); background:linear-gradient(135deg, rgba(79,70,229,0.22), rgba(124,58,237,0.12)); padding:clamp(28px,5vw,44px) clamp(20px,4vw,48px);">
            <div style="position:absolute; right:-60px; top:-60px; width:320px; height:320px; border-radius:50%; background:radial-gradient(circle, rgba(45,212,191,0.16), rgba(10,11,20,0) 70%);"></div>
            <div style="position:relative;">
              <span style="display:inline-block; background:#2DD4BF; color:#052E28; font-size:11px; font-weight:700; padding:4px 11px; border-radius:999px; letter-spacing:0.04em;">MAX TIER</span>
              {/* The rotating model name is aria-hidden; screen readers get the stable "Claude". */}
              <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(26px,4.5vw,34px); letter-spacing:-0.03em; line-height:1.16; margin:16px 0 0;">
                Ask <span style="position:absolute; width:1px; height:1px; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap;">Claude</span><span class="model-rotate" data-model-rotator aria-hidden="true" style="white-space:nowrap;"><span data-model-headline>Fable 5</span><i class="model-caret" aria-hidden="true"></i></span>.<br />Get your community&rsquo;s answer.
              </h2>
              <p style="font-size:16px; line-height:1.6; color:#CfCfE6; margin:14px 0 0; max-width:480px;">Max makes your published answers searchable by the AI assistants your members already use. Ask about your product in Claude or ChatGPT, and instead of guessing, it answers with the fix your community already wrote.</p>
              <ul style="list-style:none; padding:0; margin:22px 0 0; display:flex; flex-direction:column; gap:11px;">
                <li style="display:flex; gap:10px; font-size:14.5px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> Works in Claude, ChatGPT, Cursor, and anywhere else your members ask</li>
                <li style="display:flex; gap:10px; font-size:14.5px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> Every answer cites the solved thread it came from</li>
                <li style="display:flex; gap:10px; font-size:14.5px; color:#DBDEE1;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span> One link to connect, no code (it speaks MCP, for those who do)</li>
              </ul>
            </div>
            <AssistantDemo />
          </div>
        </div>
      </section>

      {/* ===== OPEN SOURCE ===== */}
      {/* The privacy promises above are only worth as much as they are checkable,
          so this section is the receipt: every claim links to where you verify it. */}
      <section id="open-source" style="padding:clamp(48px,8vw,80px) clamp(16px,4vw,32px);">
        <div style="max-width:1200px; margin:0 auto;">
          <div style="text-align:center; max-width:640px; margin:0 auto;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:#A78BFA; font-weight:500;">Open source</div>
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,5vw,38px); letter-spacing:-0.03em; margin:14px 0 0;">Don&rsquo;t trust us. Read the code.</h2>
            <p style="font-size:16px; line-height:1.6; color:#9AA0C3; margin:16px 0 0;">Your community&rsquo;s questions are your data. Every line of Dejavue &mdash; the bot, the worker, the website &mdash; is public under the <strong style="color:#DBDEE1; font-weight:600;">AGPL-3.0</strong>, so you never have to take a privacy promise on faith.</p>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; margin-top:40px;">
