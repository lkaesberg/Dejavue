---
import { getEnv } from '@dejavue/core';
import { channelGuidelinesOf, getDb, getPublishedThreads, type Thread } from '@dejavue/db';
import Echo from '../components/Echo.astro';
import KbFooter from '../components/KbFooter.astro';
import KbNav from '../components/KbNav.astro';
import Base from '../layouts/Base.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { brandOf, channelDot, channelHandle, channelKind } from '../lib/theme';

const { tenant, slug } = Astro.locals;
const notFound = slug !== null && tenant === null;
if (notFound) Astro.response.status = 404;

const origin = new URL(Astro.request.url).origin;
const env = getEnv();

// ---- Tenant KB home data -------------------------------------------------
let threads: Thread[] = [];
const cfg = Astro.locals.cfg;
if (tenant) {
  threads = await getPublishedThreads(getDb(), tenant.guildId, 1000);
}
const brand = brandOf(cfg, tenant?.slug ?? undefined);

const byChannel = new Map<string, { id: string; name: string; count: number }>();
for (const t of threads) {
  const entry = byChannel.get(t.channelId) ?? { id: t.channelId, name: t.channelName ?? 'General', count: 0 };
  entry.count += 1;
  byChannel.set(t.channelId, entry);
}
const categories = [...byChannel.values()].sort((a, b) => b.count - a.count);
const mostAsked = threads.slice(0, 5);
// Popular-search chips derived from the most recent answers (first few words).
const chips = mostAsked.slice(0, 4).map((t) => {
  const words = t.title.replace(/[?.!]/g, '').split(/\s+/).slice(0, 4).join(' ');
  return { label: words, q: t.title };
});
const handle = channelHandle;

// ---- Add-to-Discord install link (marketing) ------------------------------
const PERMS = (
  1024n /* View Channels */ +
  16n /* Manage Channels */ +
  2048n /* Send Messages */ +
  16384n /* Embed Links */ +
  65536n /* Read Message History */ +
  17179869184n /* Manage Threads */ +
  274877906944n /* Send Messages in Threads */
).toString();
const addUrl = env.DISCORD_CLIENT_ID
  ? `https://discord.com/oauth2/authorize?client_id=${env.DISCORD_CLIENT_ID}&scope=bot+applications.commands&permissions=${PERMS}`
  : '#';

// ---- Marketing static content --------------------------------------------
const featBtn =
  'background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#F4F5FF; box-shadow:0 10px 24px rgba(124,58,237,0.35);';
const ghostBtn = 'background:rgba(244,245,255,0.06); border:1px solid rgba(244,245,255,0.16); color:#F4F5FF;';
const steps = [
  { num: '1', title: 'Someone posts', body: 'A new forum thread lands. Dejavue reads the question and checks for duplicates — keyword on Free, semantic on Plus+.' },
  { num: '2', title: 'Matches surface', body: 'If it has seen it before, it replies with the closest solved threads — plus an AI-drafted answer on Plus and up.' },
  { num: '3', title: 'Mark as solved', body: 'OP, mod, or admin resolves it. The accepted answer and full transcript are captured and the tag flips to solved.' },
  { num: '4', title: 'Archived & searchable', body: 'It is embedded for semantic search, summarized, and — if opted in — published to the public knowledge base.' },
];
// AI usage is metered in AI credits: 1 credit = 1,000 model tokens (a drafted
// answer ≈ 0.8 credits, a thread summary ≈ 3). Keep in sync with README + core.
const tiers = [
  { name: 'Free', price: '$0', per: '', tag: 'Keyword detection for a single forum.', bg: 'rgba(27,29,51,0.45)', border: 'rgba(244,245,255,0.08)', featured: false, cta: 'Add to Discord', btnStyle: ghostBtn, feats: ['1 forum channel', 'Keyword duplicate detection', 'Mark-solved + archive (500 messages)', 'Basic counts', 'Public knowledge base'] },
  { name: 'Plus', price: '$4.99', per: '/mo', tag: 'Semantic search with a taste of AI answers.', bg: 'rgba(27,29,51,0.55)', border: 'rgba(244,245,255,0.1)', featured: false, cta: 'Choose Plus', btnStyle: ghostBtn, feats: ['5 forum channels', 'Semantic duplicate detection', 'AI-drafted answers · 25 credits / mo', '5,000 indexed messages', 'Stale-question nudges · full analytics', '“Powered by” removed'] },
  { name: 'Pro', price: '$9.99', per: '/mo', tag: 'The full AI suite: summaries, clustering & auto-FAQ.', bg: 'linear-gradient(180deg, rgba(79,70,229,0.2), rgba(27,29,51,0.6))', border: 'rgba(167,139,250,0.4)', featured: true, cta: 'Choose Pro', btnStyle: featBtn, feats: ['10 forum channels', 'Semantic + AI-drafted answers', '50,000 indexed messages', 'AI summaries · clustering · auto-FAQ', '1,000 AI credits / mo (≈1,200 drafts)', 'AI-summarized KB pages'] },
  { name: 'Max', price: '$24.99', per: '/mo', tag: 'Unlimited scale plus the MCP server.', bg: 'rgba(27,29,51,0.55)', border: 'rgba(45,212,191,0.3)', featured: false, cta: 'Choose Max', btnStyle: ghostBtn, feats: ['Unlimited channels & archive', '5,000 AI credits / mo', 'MCP server for your KB', 'Everything in Pro'] },
];
---

{
  tenant ? (
    <Base
      title={`${brand} — Knowledge Base`}
      description={`Search ${brand}'s solved answers — kept up to date by the community.`}
      canonical={`${origin}/`}
    >
      <KbNav />

      {/* hero + search */}
      <div class="kb-hero">
        <div class="kb-hero-inner">
            <h1 style="font-family:var(--headfont); font-weight:700; font-size:clamp(30px,5.2vw,46px); letter-spacing:-0.03em; margin:0; line-height:1.06;">How can we help?</h1>
            <p style="font-size:clamp(15px,1.6vw,17px); color:var(--textmid); margin:13px 0 0;">Search {brand}'s solved answers — kept up to date by the community.</p>
            <form action="/search" method="get" role="search" style="display:flex; align-items:center; gap:12px; max-width:600px; margin:26px auto 0; background:var(--surface); border:1.5px solid var(--border2); border-radius:var(--rad); padding:15px 18px; box-shadow:0 10px 30px rgba(20,21,42,0.07);">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--textmut)" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.5" y2="16.5" /></svg>
              <input type="search" name="q" placeholder={`Search ${threads.length} answers…`} aria-label="Search the knowledge base" style="flex:1; min-width:0; border:none; outline:none; background:transparent; font-size:16px; color:var(--text);" />
              <button type="submit" style="border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#fff; font-size:12.5px; font-weight:600; padding:8px 15px; border-radius:var(--radsm);">Search</button>
            </form>
            {chips.length > 0 && (
              <div style="display:flex; align-items:center; justify-content:center; gap:9px; margin-top:16px; flex-wrap:wrap;">
                <span style="font-size:12.5px; color:var(--textmut);">Popular:</span>
                {chips.map((ch) => (
                  <a href={`/search?q=${encodeURIComponent(ch.q)}`} style="font-size:12.5px; color:var(--accentline); background:var(--accentsoft); padding:5px 11px; border-radius:999px;">{ch.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>

        <div class="kb-home">
          {/* most asked */}
          {mostAsked.length > 0 && (
            <>
              <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600; margin-bottom:13px;">Most asked</div>
              <div style="border:1px solid var(--border); border-radius:var(--rad); overflow:hidden; background:var(--surface);">
                {mostAsked.map((q) => (
                  <a href={`/t/${q.threadId}`} class="kb-row" style="display:flex; align-items:center; gap:13px; padding:15px 18px; border-bottom:1px solid var(--border);">
                    <span style="color:#2DD4BF; font-size:14px;">✓</span>
                    <span style="font-size:14.5px; color:var(--text); flex:1; font-weight:500;">{q.title}</span>
                    {q.channelName && (
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--chiptext); background:var(--chipbg); padding:3px 9px; border-radius:999px; white-space:nowrap;">{q.channelName}</span>
                    )}
                  </a>
                ))}
              </div>
            </>
          )}

          {/* channels */}
          <div style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--textmut); font-weight:600; margin:30px 0 13px;">Channels</div>
          {categories.length === 0 ? (
            <p style="font-size:14px; color:var(--textmut);">No published answers yet — check back soon.</p>
          ) : (
            <div class="cat-grid">
              {categories.map((c) => {
                const guidelines = channelGuidelinesOf(cfg, c.id);
                const kind = channelKind(cfg, c.id);
                return (
                  <a href={`/c/${c.id}`} class="kb-card-hover" style="border:1px solid var(--border); border-radius:var(--rad); padding:18px 20px; display:block; background:var(--surface);">
                    <div style="display:flex; align-items:center; justify-content:space-between;">
                      <span style="display:flex; align-items:center; gap:9px;">
                        <span style={`width:9px; height:9px; border-radius:50%; background:${channelDot(c.id)};`}></span>
                        <span style="font-family:var(--headfont); font-weight:600; font-size:16px; letter-spacing:-0.01em; color:var(--text);">{c.name}</span>
                      </span>
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--chiptext); background:var(--chipbg); padding:3px 9px; border-radius:999px;">{c.count}</span>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                      <span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--accentline);">{handle(c.name)}</span>
                      <span style={`font-size:10px; font-weight:600; padding:2px 8px; border-radius:999px; background:${kind.bg}; color:${kind.fg};`}>{kind.label}</span>
                    </div>
                    {guidelines && (
                      <div style="font-size:13.5px; color:var(--textmid); margin-top:7px; line-height:1.45;">
                        {guidelines.length > 130 ? `${guidelines.slice(0, 130)}…` : guidelines}
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          )}
        </div>

        <KbFooter note={`Updated daily · ${threads.length} answers indexed`} />
    </Base>
  ) : notFound ? (
    <Base title="Knowledge base not found" noindex>
      <div class="kb-bound" style="padding-top:80px; padding-bottom:80px; text-align:center;">
        <Echo size={48} style="margin:0 auto;" />
        <h1 style="font-family:var(--headfont); font-weight:700; font-size:28px; letter-spacing:-0.03em; margin:24px 0 0;">Knowledge base not found</h1>
        <p style="font-size:15px; color:var(--textmid); margin:12px 0 0;">This community hasn't set up a public knowledge base.</p>
      </div>
    </Base>
  ) : (
    <SiteLayout
      title="Dejavue — never answer the same question twice"
      description="A Discord bot that catches duplicate questions, drives a mark-solved workflow, and turns your forum into a searchable, SEO-ready knowledge base."
      canonical={`${origin}/`}
    >
      {/* ===== NAV ===== */}
      <nav style="position:sticky; top:0; z-index:50; backdrop-filter:blur(14px); background:rgba(10,11,20,0.72); border-bottom:1px solid rgba(244,245,255,0.07);">
        <div style="max-width:1200px; margin:0 auto; padding:14px clamp(16px,4vw,32px); display:flex; align-items:center; justify-content:space-between; gap:16px;">
          <div style="display:flex; align-items:center; gap:11px;">
            <Echo tile="none" bubbleFill="#F4F5FF" checkFill="#2DD4BF" echoFill="#A78BFA" echoOpacity={0.6} size={32} />
            <span style="font-family:'Space Grotesk',sans-serif; font-weight:500; font-size:21px; letter-spacing:-0.04em;">dejavue</span>
          </div>
          <div class="site-nav-links">
            <a href="#how" style="font-size:14px; color:#9AA0C3;">How it works</a>
            <a href="#features" style="font-size:14px; color:#9AA0C3;">Features</a>
            <a href="#kb" style="font-size:14px; color:#9AA0C3;">Knowledge base</a>
            <a href="#pricing" style="font-size:14px; color:#9AA0C3;">Pricing</a>
            <a class="cta" href={addUrl} style="font-size:14px; font-weight:600; color:#F4F5FF; background:linear-gradient(135deg,#4F46E5,#7C3AED); padding:10px 18px; border-radius:10px; box-shadow:0 6px 18px rgba(124,58,237,0.35);">Add to Discord</a>
          </div>
        </div>
      </nav>

      {/* ===== HERO ===== */}
      <header style="position:relative; padding:clamp(56px,9vw,96px) clamp(16px,4vw,32px) clamp(52px,8vw,88px);">
        <div style="position:absolute; top:-160px; right:-80px; width:680px; height:680px; border-radius:50%; background:radial-gradient(circle, rgba(124,58,237,0.32), rgba(79,70,229,0.08) 42%, rgba(10,11,20,0) 70%); pointer-events:none;"></div>
        <div style="position:absolute; top:120px; left:-180px; width:520px; height:520px; border-radius:50%; background:radial-gradient(circle, rgba(45,212,191,0.10), rgba(10,11,20,0) 68%); pointer-events:none;"></div>
        <div class="hero-grid" style="position:relative; max-width:1200px; margin:0 auto;">
          <div>
            <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(167,139,250,0.12); border:1px solid rgba(167,139,250,0.28); color:#C4B5FD; font-size:13px; font-weight:500; padding:7px 14px; border-radius:999px;">
              <span style="width:6px; height:6px; border-radius:50%; background:#2DD4BF; box-shadow:0 0 0 4px rgba(45,212,191,0.18);"></span>
              A Discord bot for help &amp; Q&amp;A forums
            </div>
            <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(34px,8vw,62px); line-height:1.02; letter-spacing:-0.038em; margin:24px 0 0;">Never answer the same question twice.</h1>
            <p style="font-size:clamp(16px,2.4vw,19px); line-height:1.55; color:#9AA0C3; margin:24px 0 0; max-width:520px;">Dejavue catches duplicate questions the moment they're posted, surfaces the answer from past solved threads, and turns your forum into a searchable, SEO-ready knowledge base.</p>
            <div style="display:flex; gap:14px; margin-top:36px; flex-wrap:wrap;">
              <a href={addUrl} style="display:inline-flex; align-items:center; gap:9px; background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#F4F5FF; font-size:15px; font-weight:600; padding:15px 26px; border-radius:12px; box-shadow:0 12px 30px rgba(124,58,237,0.4);">Add to Discord — free</a>
              <a href="#how" style="display:inline-flex; align-items:center; gap:9px; background:rgba(244,245,255,0.05); border:1px solid rgba(244,245,255,0.16); color:#F4F5FF; font-size:15px; font-weight:600; padding:15px 26px; border-radius:12px;">See how it works</a>
            </div>
            <div style="display:flex; align-items:center; gap:22px; margin-top:30px; color:#6F7596; font-size:13px; flex-wrap:wrap;">
              <span style="display:inline-flex; align-items:center; gap:7px;"><span style="color:#2DD4BF;">✓</span> Free tier, no card</span>
              <span style="display:inline-flex; align-items:center; gap:7px;"><span style="color:#2DD4BF;">✓</span> Live in under a minute</span>
            </div>
          </div>

          {/* discord mockup */}
          <div style="position:relative;">
            <div style="position:absolute; inset:-6% -4% -6% -4%; border-radius:50%; background:radial-gradient(circle, rgba(124,58,237,0.22), rgba(10,11,20,0) 70%);"></div>
            <div style="position:relative; animation:dvFloat 7s ease-in-out infinite;">
              <div style="background:#313338; border-radius:16px; overflow:hidden; box-shadow:0 30px 70px rgba(0,0,0,0.55); border:1px solid rgba(0,0,0,0.3);">
                <div style="padding:16px 18px; border-bottom:1px solid rgba(0,0,0,0.25); display:flex; align-items:center; gap:10px;">
                  <span style="color:#949BA4; font-size:18px;">#</span>
                  <span style="font-weight:600; font-size:15px; color:#F2F3F5;">how do I rotate my API key?</span>
                  <span style="margin-left:auto; display:inline-flex; align-items:center; gap:6px; background:rgba(242,63,67,0.14); color:#F77; font-size:11px; font-weight:600; padding:4px 9px; border-radius:6px;"><span style="width:6px;height:6px;border-radius:50%;background:#F23F43;"></span>unsolved</span>
                </div>
                <div style="padding:16px 18px; display:flex; gap:12px;">
                  <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,#F0883E,#E0632C); flex-shrink:0;"></div>
                  <div>
                    <div style="display:flex; align-items:baseline; gap:8px;"><span style="font-weight:600; font-size:14px; color:#F2A35E;">maya_dev</span><span style="font-size:11px; color:#949BA4;">Today at 14:02</span></div>
                    <div style="font-size:14px; color:#DBDEE1; margin-top:3px; line-height:1.45;">Anyone know how to rotate the API key without downtime? Can't find it in settings.</div>
                  </div>
                </div>
                <div style="padding:0 18px 18px;">
                  <div style="display:flex; gap:12px;">
                    <Echo tile="gradient" round={true} size={38} style="flex-shrink:0;" />
                    <div style="flex:1; min-width:0;">
                      <div style="display:flex; align-items:center; gap:7px;"><span style="font-weight:600; font-size:14px; color:#F4F5FF;">Dejavue</span><span style="background:#5865F2; color:#fff; font-size:9px; font-weight:600; padding:1px 5px; border-radius:4px; letter-spacing:0.02em;">APP</span><span style="font-size:11px; color:#949BA4;">14:02</span></div>
                      <div style="margin-top:7px; background:#2B2D31; border-left:4px solid #7C3AED; border-radius:6px; padding:14px 16px;">
                        <div style="display:flex; align-items:center; gap:8px; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:15px; color:#F4F5FF;">I&rsquo;ve seen this before</div>
                        <div style="font-size:12.5px; color:#B5BAC1; margin-top:4px;">3 solved threads look like a match:</div>
                        <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px;">
                          <div style="display:flex; align-items:center; gap:10px; background:#1E1F22; border-radius:8px; padding:10px 12px;"><span style="color:#2DD4BF; font-size:13px;">✓</span><span style="font-size:13px; color:#DBDEE1; flex:1; min-width:0;">Rotating API keys with zero downtime</span><span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; font-weight:600;">96%</span></div>
                          <div style="display:flex; align-items:center; gap:10px; background:#1E1F22; border-radius:8px; padding:10px 12px;"><span style="color:#2DD4BF; font-size:13px;">✓</span><span style="font-size:13px; color:#DBDEE1; flex:1; min-width:0;">Where to find key management settings</span><span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; font-weight:600;">89%</span></div>
                          <div style="display:flex; align-items:center; gap:10px; background:#1E1F22; border-radius:8px; padding:10px 12px;"><span style="color:#2DD4BF; font-size:13px;">✓</span><span style="font-size:13px; color:#DBDEE1; flex:1; min-width:0;">API key best practices &amp; expiry</span><span style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; font-weight:600;">81%</span></div>
                        </div>
                        <div style="display:flex; gap:8px; margin-top:13px; flex-wrap:wrap;">
                          <span style="background:#248046; color:#fff; font-size:12.5px; font-weight:600; padding:8px 14px; border-radius:6px;">Use top answer &amp; close</span>
                          <span style="background:#4E5058; color:#fff; font-size:12.5px; font-weight:600; padding:8px 14px; border-radius:6px;">Not a duplicate</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      {/* ===== HOW IT WORKS ===== */}
      <section id="how" style="padding:clamp(48px,8vw,80px) clamp(16px,4vw,32px); border-top:1px solid rgba(244,245,255,0.06);">
        <div style="max-width:1200px; margin:0 auto;">
          <div style="text-align:center; max-width:640px; margin:0 auto;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:#A78BFA; font-weight:500;">The loop</div>
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,5vw,40px); letter-spacing:-0.03em; margin:14px 0 0;">Detect → solve → archive → search</h2>
            <p style="font-size:17px; line-height:1.55; color:#9AA0C3; margin:16px 0 0;">Every solved thread makes the next answer faster. Dejavue closes the loop automatically.</p>
          </div>
          <div class="steps-grid" style="margin-top:52px;">
            {steps.map((s) => (
              <div style="background:linear-gradient(180deg, rgba(27,29,51,0.9), rgba(20,21,38,0.6)); border:1px solid rgba(244,245,255,0.07); border-radius:18px; padding:26px 22px;">
                <div style="display:flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:11px; background:rgba(124,58,237,0.16); border:1px solid rgba(167,139,250,0.25); font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:16px; color:#C4B5FD;">{s.num}</div>
                <div style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:18px; margin-top:18px; letter-spacing:-0.01em;">{s.title}</div>
                <div style="font-size:14px; line-height:1.5; color:#9AA0C3; margin-top:8px;">{s.body}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ===== FEATURES BENTO ===== */}
      <section id="features" style="padding:clamp(48px,8vw,80px) clamp(16px,4vw,32px);">
        <div style="max-width:1200px; margin:0 auto;">
          <div style="max-width:640px;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; color:#A78BFA; font-weight:500;">Features</div>
            <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(28px,5vw,40px); letter-spacing:-0.03em; margin:14px 0 0;">Built for forums that move fast</h2>
          </div>
          <div class="bento" style="margin-top:48px;">
            <div class="bento-lg" style="background:linear-gradient(155deg, rgba(79,70,229,0.18), rgba(27,29,51,0.5)); border:1px solid rgba(167,139,250,0.18); border-radius:20px; padding:32px; display:flex; flex-direction:column;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase;">Semantic search</div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:24px; letter-spacing:-0.02em; margin:10px 0 0;">Finds the answer, not the keyword</h3>
              <p style="font-size:14.5px; line-height:1.55; color:#9AA0C3; margin:12px 0 0; max-width:380px;">pgvector embeddings match questions by meaning, so &ldquo;rotate my key&rdquo; finds &ldquo;cycle credentials&rdquo;. Keyword on Free, semantic from Plus up.</p>
              <div style="margin-top:auto; padding-top:24px;">
                <div style="background:#13141F; border:1px solid rgba(244,245,255,0.08); border-radius:12px; padding:12px 14px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;"><span style="color:#6F7596;">/</span><span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#DBDEE1;">dejavue search</span><span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:#A78BFA;">cycle credentials</span></div>
              </div>
            </div>
            <div class="bento-3" style="background:rgba(27,29,51,0.55); border:1px solid rgba(244,245,255,0.07); border-radius:20px; padding:28px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase;">Mark-solved workflow</div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:21px; letter-spacing:-0.02em; margin:9px 0 12px;">One click flips the tag</h3>
              <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                <span style="display:inline-flex; align-items:center; gap:6px; background:rgba(242,63,67,0.14); color:#F77; font-size:12px; font-weight:600; padding:5px 11px; border-radius:7px;"><span style="width:6px;height:6px;border-radius:50%;background:#F23F43;"></span>unsolved</span>
                <span style="color:#6F7596; font-size:18px;">&rarr;</span>
                <span style="display:inline-flex; align-items:center; gap:6px; background:rgba(35,165,90,0.16); color:#3BE08A; font-size:12px; font-weight:600; padding:5px 11px; border-radius:7px;"><span style="color:#2DD4BF;">✓</span>solved</span>
              </div>
              <p style="font-size:14px; line-height:1.5; color:#9AA0C3; margin:14px 0 0;">Button, modal, or right-click → Mark as Answer. The accepted answer and full transcript are captured every time.</p>
            </div>
            <div class="bento-3" style="background:rgba(27,29,51,0.55); border:1px solid rgba(244,245,255,0.07); border-radius:20px; padding:28px;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase; white-space:nowrap;">AI answers</div>
                <span style="background:linear-gradient(135deg,#4F46E5,#7C3AED); color:#fff; font-size:10px; font-weight:600; padding:3px 9px; border-radius:999px; white-space:nowrap;">PLUS &amp; UP</span>
              </div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:21px; letter-spacing:-0.02em; margin:9px 0 12px;">Drafts answers from solved threads</h3>
              <p style="font-size:14px; line-height:1.5; color:#9AA0C3; margin:0;">Drafted answers from Plus; KB summaries, knowledge-gap clustering, and auto-FAQ on Pro &amp; Max — metered in monthly AI credits, topped up any time.</p>
            </div>
            <div class="bento-2" style="background:rgba(27,29,51,0.55); border:1px solid rgba(244,245,255,0.07); border-radius:20px; padding:26px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase;">Analytics</div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:18px; letter-spacing:-0.02em; margin:9px 0 4px;">Resolution rate &amp; top helpers</h3>
              <p style="font-size:13.5px; line-height:1.5; color:#9AA0C3; margin:0;">Time-to-resolution and most-asked, surfaced in Discord.</p>
            </div>
            <div class="bento-2" style="background:rgba(27,29,51,0.55); border:1px solid rgba(244,245,255,0.07); border-radius:20px; padding:26px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase;">Nudges</div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:18px; letter-spacing:-0.02em; margin:9px 0 4px;">Stale questions get a ping</h3>
              <p style="font-size:13.5px; line-height:1.5; color:#9AA0C3; margin:0;">Ping a helper role on a timer so nothing rots unanswered.</p>
            </div>
            <div class="bento-2" style="background:rgba(27,29,51,0.55); border:1px solid rgba(244,245,255,0.07); border-radius:20px; padding:26px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#A78BFA; letter-spacing:0.12em; text-transform:uppercase;">Backfill</div>
              <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:18px; letter-spacing:-0.02em; margin:9px 0 4px;">Import your whole history</h3>
              <p style="font-size:13.5px; line-height:1.5; color:#9AA0C3; margin:0;">On setup, past threads are imported up to your tier — deduped and, if the KB is on, published.</p>
            </div>
          </div>
        </div>
      </section>

      {/* ===== KB SHOWCASE ===== */}
