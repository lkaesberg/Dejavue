            <a href={repoUrl} rel="noopener" style="display:inline-flex; align-items:center; gap:9px; background:rgba(244,245,255,0.06); border:1px solid rgba(244,245,255,0.16); color:#F4F5FF; font-size:15px; font-weight:600; padding:14px 24px; border-radius:12px;"><GitHubIcon size={18} />View on GitHub</a>
