                <div style="display:flex; align-items:baseline; gap:4px; margin-top:10px;">
                  <span style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:34px; letter-spacing:-0.03em;">{t.price}</span>
                  <span style="font-size:13px; color:#9AA0C3;">{t.per}</span>
                </div>
                <div style="font-size:13px; color:#9AA0C3; margin-top:8px; min-height:36px;">{t.tag}</div>
                <div style="height:1px; background:rgba(244,245,255,0.08); margin:18px 0;"></div>
                <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:11px; flex:1;">
                  {t.feats.map((f) => (
                    <li style="display:flex; gap:9px; font-size:13.5px; color:#DBDEE1; line-height:1.45;"><span style="color:#2DD4BF; flex-shrink:0;">✓</span><span>{f}</span></li>
                  ))}
                </ul>
                <a href={addUrl} style={`display:block; text-align:center; margin-top:22px; padding:12px; border-radius:11px; font-size:14px; font-weight:600; ${t.btnStyle}`}>{t.cta}</a>
              </div>
            ))}
          </div>
          <p style="text-align:center; font-size:13px; color:#6F7596; margin-top:28px;">Importing your existing history is free, up to each tier's indexed-message limit. One-time add-ons — <span style="color:#9AA0C3;">Custom domain</span>, <span style="color:#9AA0C3;">AI top-up (+250 credits, stacks, never expires)</span>. Prices are suggestions set per SKU.</p>
        </div>
      </section>

      {/* ===== CTA ===== */}
      <section style="padding:clamp(24px,5vw,40px) clamp(16px,4vw,32px) clamp(56px,9vw,88px);">
        <div style="max-width:1000px; margin:0 auto; text-align:center; position:relative;">
          <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:560px; height:360px; max-width:100%; background:radial-gradient(circle, rgba(124,58,237,0.22), rgba(10,11,20,0) 70%); pointer-events:none;"></div>
