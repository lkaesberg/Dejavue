}

<style>
  /* Typewriter caret for the rotating model name in the AI-assistant callout.
     The type/delete loop lives in AssistantDemo.astro and toggles .is-morphing. */
  .model-caret {
    display: inline-block;
    width: 0;
    height: 0.78em;
    border-radius: 2px;
    background: #a78bfa;
    opacity: 0;
    vertical-align: -0.04em;
    transition: opacity 200ms ease;
  }

  .model-rotate.is-morphing .model-caret {
    width: 3px;
    margin-left: 4px;
    opacity: 1;
    animation: model-caret-blink 700ms steps(1, end) infinite;
  }

  @keyframes model-caret-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .model-caret { display: none; }
  }
</style>
