          <div class="mcp-grid" style="position:relative; overflow:hidden; border-radius:24px; border:1px solid rgba(167,139,250,0.22); background:linear-gradient(135deg, rgba(79,70,229,0.22), rgba(124,58,237,0.12)); padding:clamp(28px,5vw,48px) clamp(20px,4vw,52px);">
            <div style="position:absolute; right:-60px; top:-60px; width:320px; height:320px; border-radius:50%; background:radial-gradient(circle, rgba(45,212,191,0.16), rgba(10,11,20,0) 70%);"></div>
            <div style="position:relative;">
              <span style="display:inline-block; background:#0A0B14; color:#2DD4BF; font-size:11px; font-weight:600; padding:4px 11px; border-radius:999px; letter-spacing:0.04em;">MAX TIER</span>
              <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:clamp(26px,4.5vw,34px); letter-spacing:-0.03em; margin:16px 0 0;">Your community is an MCP server</h2>
              <p style="font-size:16px; line-height:1.6; color:#CfCfE6; margin:14px 0 0; max-width:480px;">Each Max guild exposes its knowledge base as a Streamable HTTP MCP server. Point Claude or any MCP client at it and let your AI answer from the questions your community already solved.</p>
            </div>
            <div style="position:relative; background:#0A0B14; border:1px solid rgba(244,245,255,0.1); border-radius:14px; padding:20px; font-family:'JetBrains Mono',monospace; font-size:13px; line-height:1.7; overflow-x:auto;">
