{
  "name": "dejavue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @dejavue/db generate",
    "db:migrate": "pnpm --filter @dejavue/db migrate",
    "db:verify": "pnpm --filter @dejavue/db verify",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "docker compose up -d --wait postgres && pnpm db:migrate && pnpm -r --parallel dev",
    "dev:bot": "pnpm --filter @dejavue/bot dev",
    "dev:worker": "pnpm --filter @dejavue/worker dev",
    "dev:web": "pnpm --filter @dejavue/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.28.0": "^6.28.0",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "fast-uri@<3.1.5": "^3.1.5",
      "svgo@<4.0.2": "^4.0.2",
      "yaml@<2.8.3": "^2.8.3",
      "protobufjs@<7.6.5": "^7.6.5",
      "sharp@<0.35.0": "^0.35.4",
      "esbuild@<0.28.1": "^0.28.1"
    }
  }
}
